{%- comment -%}
  EG The Luxury of Handmade — sections/eg-luxury.liquid
  Simon layout 08. Heading, then a dark text panel beside a close-up image,
  then a full-width film. Each "Slide" block is one message + image;
  the dots in the dark panel switch between them.
  Self-contained: no snippet needed.
{%- endcomment -%}

<div class="eglux" id="eglux-{{ section.id }}" style="--eglux-panel: {{ section.settings.panel_bg }}; padding-top: {{ section.settings.pad_top }}rem; padding-bottom: {{ section.settings.pad_bottom }}rem;">
  {%- if section.settings.heading != blank -%}
    <h2 class="eglux__heading">{{ section.settings.heading }}</h2>
  {%- endif -%}

  {%- if section.blocks.size > 0 -%}
    <div class="eglux__split" data-eglux-card>
      <div class="eglux__panel" data-eglux-media>
        {%- for block in section.blocks -%}
          <div class="eglux__copy{% if forloop.first %} is-active{% endif %}" data-eglux-slide="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
            {%- if block.settings.title != blank -%}
              <h3 class="eglux__title">{{ block.settings.title | newline_to_br }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p class="eglux__text">{{ block.settings.text | newline_to_br }}</p>
            {%- endif -%}
            {%- if block.settings.link_label != blank -%}
              <a class="eglux__link" href="{{ block.settings.link | default: '#' }}">{{ block.settings.link_label }}</a>
            {%- endif -%}
          </div>
        {%- endfor -%}

        {%- if section.blocks.size > 1 -%}
          <div class="eglux__dots" role="group" aria-label="Slides">
            {%- for block in section.blocks -%}
              <button type="button" class="eglux__dot{% if forloop.first %} is-active{% endif %}" data-eglux-dot="{{ forloop.index0 }}" aria-label="Show slide {{ forloop.index }} of {{ forloop.length }}"{% if forloop.first %} aria-current="true"{% endif %}></button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <div class="eglux__image">
        {%- for block in section.blocks -%}
          <div class="eglux__slide{% if forloop.first %} is-active{% endif %}" data-eglux-slide="{{ forloop.index0 }}">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 1800 | image_tag:
                 loading: 'lazy', sizes: '(min-width: 750px) 50vw, 100vw',
                 widths: '600, 900, 1200, 1800',
                 class: 'eglux__img', alt: '' }}
            {%- else -%}
              {{ 'detailed-apparel-1' | placeholder_svg_tag: 'eglux__img eglux__placeholder' }}
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}

  {%- if section.settings.video != blank or section.settings.poster != blank -%}
    <div class="eglux__band">
      {%- if section.settings.video != blank -%}
        {{ section.settings.video | video_tag:
           autoplay: true, loop: true, muted: true, controls: false,
           image_size: '2000x', class: 'eglux__fill' }}
      {%- else -%}
        {{ section.settings.poster | image_url: width: 3000 | image_tag:
           loading: 'lazy', sizes: '100vw',
           widths: '750, 1100, 1500, 2000, 3000',
           class: 'eglux__fill', alt: '' }}
      {%- endif -%}
    </div>
  {%- endif -%}
</div>

{%- style -%}
  .eglux__heading {
    margin: 0 0 clamp(2.5rem, 5vw, 4.5rem);
    padding: 0 1.5rem;
    text-align: center;
    font-family: var(--eg-serif, 'Cormorant Garamond', serif);
    font-weight: 400;
    font-size: clamp(1.9rem, 3vw, 3rem);
    color: var(--eg-ink, #1a1a1a);
  }

  .eglux__split {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }
  .eglux__panel,
  .eglux__image {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
  }

  .eglux__panel {
    background: var(--eglux-panel);
    color: #fff;
    touch-action: pan-y;
  }
  .eglux__copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 17% 12% 19%;
    text-align: center;
  }
  .eglux__title {
    margin: 0 0 clamp(1.5rem, 3vw, 2.5rem);
    font-family: var(--eg-serif, 'Cormorant Garamond', serif);
    font-weight: 400;
    font-size: clamp(1.6rem, 2.3vw, 2.4rem);
    line-height: 1.2;
  }
  .eglux__text {
    max-width: 26rem;
    margin: 0;
    font-family: var(--eg-serif, 'Cormorant Garamond', serif);
    font-size: clamp(1rem, 1.15vw, 1.18rem);
    line-height: 1.55;
    letter-spacing: 0.03em;
    opacity: 0.78;
  }
  .eglux__link {
    margin-top: auto;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid currentColor;
    font-family: var(--eg-sans, Inter, sans-serif);
    font-size: 0.66rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: inherit;
    text-decoration: none;
    transition: opacity 0.3s ease;
  }
  .eglux__link:hover { opacity: 0.6; }

  /* Slides + dots (self-contained) */
  .eglux__copy, .eglux__slide {
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.6s var(--eg-ease, cubic-bezier(0.22, 1, 0.36, 1)), visibility 0s linear 0.6s;
  }
  .eglux__copy.is-active, .eglux__slide.is-active {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.6s var(--eg-ease, cubic-bezier(0.22, 1, 0.36, 1)), visibility 0s;
  }
  .eglux__dots { display: flex; justify-content: center; }
  .eglux__dot {
    position: relative;
    width: 14px;
    height: 18px;
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
  }
  .eglux__dot::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: currentColor;
    opacity: 0.25;
    transform: translate(-50%, -50%);
    transition: opacity 0.3s ease;
  }
  .eglux__dot:hover::before { opacity: 0.6; }
  .eglux__dot.is-active::before { opacity: 1; }
  .eglux__dot:focus-visible { outline: 1px solid currentColor; outline-offset: -3px; }
  @media (prefers-reduced-motion: reduce) {
    .eglux__copy, .eglux__slide, .eglux__copy.is-active, .eglux__slide.is-active { transition: none; }
  }

  .eglux__slide { position: absolute; inset: 0; }
  .eglux__copy { position: absolute; inset: 0; }

  .eglux__dots {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 5.5%;
    z-index: 2;
    color: #fff;
  }

  .eglux__img,
  .eglux__fill {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }
  .eglux__placeholder { background: #d9d6d3; }

  .eglux__band {
    position: relative;
    margin-top: 0.6rem;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #111;
  }

  @media screen and (max-width: 749px) {
    .eglux__split { grid-template-columns: 1fr; }
    .eglux__panel { aspect-ratio: 4 / 5; }
    .eglux__copy { padding: 18% 10% 22%; }
    .eglux__band { aspect-ratio: 4 / 5; }
  }
{%- endstyle -%}

<script>
  (function () {
    function setup(root) {
      if (!root || root.dataset.egluxReady) return;
      root.dataset.egluxReady = 'true';

      root.querySelectorAll('[data-eglux-card]').forEach(function (card) {
        var slides = card.querySelectorAll('[data-eglux-slide]');
        var dots = card.querySelectorAll('[data-eglux-dot]');
        var media = card.querySelector('[data-eglux-media]');
        var total = dots.length;
        if (total < 2) return;

        var current = 0;
        var swiped = false;

        function go(index) {
          current = (index + total) % total;
          slides.forEach(function (s) {
            s.classList.toggle('is-active', parseInt(s.getAttribute('data-eglux-slide'), 10) === current);
          });
          dots.forEach(function (d, i) {
            var on = i === current;
            d.classList.toggle('is-active', on);
            if (on) { d.setAttribute('aria-current', 'true'); } else { d.removeAttribute('aria-current'); }
          });
        }

        dots.forEach(function (dot) {
          dot.addEventListener('click', function (e) {
            e.preventDefault();
            e.stopPropagation();
            go(parseInt(dot.getAttribute('data-eglux-dot'), 10));
          });
        });

        if (media) {
          var startX = 0;
          var startY = 0;
          media.addEventListener('touchstart', function (e) {
            startX = e.touches[0].clientX;
            startY = e.touches[0].clientY;
          }, { passive: true });
          media.addEventListener('touchend', function (e) {
            var dx = e.changedTouches[0].clientX - startX;
            var dy = e.changedTouches[0].clientY - startY;
            if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy)) {
              swiped = true;
              go(dx < 0 ? current + 1 : current - 1);
              setTimeout(function () { swiped = false; }, 400);
            }
          }, { passive: true });
          media.addEventListener('click', function (e) {
            if (swiped) { e.preventDefault(); e.stopPropagation(); }
          }, true);
        }
      });
    }

    function init() {
      setup(document.getElementById('eglux-{{ section.id }}'));
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
    document.addEventListener('shopify:section:load', function (e) {
      setup(e.target.querySelector('.eglux'));
    });
  })();
</script>

{% schema %}
{
  "name": "EG Luxury of Handmade",
  "tag": "section",
  "class": "section",
  "max_blocks": 6,
  "settings": [
    { "type": "paragraph", "content": "Simon's section 08. Each Slide is one message in the dark panel plus the image beside it." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Luxury of Handmade®" },
    { "type": "color", "id": "panel_bg", "label": "Panel color", "default": "#0E0E0E" },
    { "type": "header", "content": "Film below" },
    { "type": "video", "id": "video", "label": "Film (MP4)" },
    { "type": "image_picker", "id": "poster", "label": "Still image", "info": "Shows if no film is uploaded. Leave both blank to hide." },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "pad_top", "min": 0, "max": 16, "step": 1, "unit": "rem", "label": "Space above", "default": 7 },
    { "type": "range", "id": "pad_bottom", "min": 0, "max": 16, "step": 1, "unit": "rem", "label": "Space below", "default": 0 }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "textarea", "id": "title", "label": "Title", "default": "Made Slowly,\nMade Exceptionally." },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Made by hand, kept for a lifetime. Every piece in our collections is made by an independent studio, vetted for material mastery and singular craftsmanship." },
        { "type": "text", "id": "link_label", "label": "Link text", "default": "Discover Our Artisans" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "image_picker", "id": "image", "label": "Image" }
      ]
    }
  ],
  "presets": [
    {
      "name": "EG Luxury of Handmade",
      "blocks": [ { "type": "slide" } ]
    }
  ]
}
{% endschema %}