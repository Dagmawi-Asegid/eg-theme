{%- comment -%}
  EG Inside the Atelier — sections/eg-atelier.liquid
  Simon layout 06 + 07 in one section.
  06 Featured Artisan: heading, studio film, name + role next to their story.
  07 Their Work: three pieces from the artisan's collection + link to it.
  Pick the artisan's collection. Name and story fill in from the collection's
  artisan fields (collectionartisan.name / .story) unless typed in below.
{%- endcomment -%}

{%- liquid
  assign c = section.settings.collection

  assign artisan_name = section.settings.name
  if artisan_name == blank and c != blank
    assign artisan_name = c.metafields.collectionartisan.name.value | default: c.title
  endif

  assign story = section.settings.story
  if story == blank and c != blank
    if c.metafields.collectionartisan.story != blank
      assign story = c.metafields.collectionartisan.story.value | newline_to_br | prepend: '<p>' | append: '</p>'
    endif
  endif

  assign show_portrait = false
  if section.settings.portrait != blank
    assign show_portrait = true
  endif

  assign product_limit = 3
  if show_portrait
    assign product_limit = 2
  endif

  assign link_label = section.settings.link_label | replace: '[name]', artisan_name
-%}

<div class="egat" style="padding-top: {{ section.settings.pad_top }}rem; padding-bottom: {{ section.settings.pad_bottom }}rem;">
  {%- if section.settings.heading != blank -%}
    <h2 class="egat__heading">{{ section.settings.heading }}</h2>
  {%- endif -%}

  {%- if section.settings.video != blank or section.settings.poster != blank -%}
    <div class="egat__film">
      {%- if section.settings.video != blank -%}
        {{ section.settings.video | video_tag:
           autoplay: true, loop: true, muted: true, controls: false,
           image_size: '2000x', class: 'egat__fill' }}
      {%- else -%}
        {{ section.settings.poster | image_url: width: 3000 | image_tag:
           loading: 'lazy', sizes: '100vw',
           widths: '750, 1100, 1500, 2000, 3000',
           class: 'egat__fill', alt: artisan_name }}
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="egat__intro">
    <div class="egat__who">
      {%- if artisan_name != blank -%}
        <p class="egat__name">{{ artisan_name }}</p>
      {%- endif -%}
      {%- if section.settings.role != blank -%}
        <p class="egat__role">{{ section.settings.role }}</p>
      {%- endif -%}
    </div>
    {%- if story != blank -%}
      <div class="egat__story">{{ story }}</div>
    {%- endif -%}
  </div>

  <ul class="egat__work" role="list">
    {%- if show_portrait -%}
      <li class="egat__piece">
        <div class="egat__piece-media">
          {{ section.settings.portrait | image_url: width: 1000 | image_tag:
             loading: 'lazy', sizes: '(min-width: 750px) 29vw, 90vw',
             widths: '400, 600, 800, 1000',
             class: 'egat__piece-img', alt: artisan_name }}
        </div>
        {%- if section.settings.portrait_label != blank -%}
          <p class="egat__piece-label">{{ section.settings.portrait_label }}</p>
        {%- endif -%}
      </li>
    {%- endif -%}

    {%- if c != blank and c.products_count > 0 -%}
      {%- for product in c.products limit: product_limit -%}
        <li class="egat__piece">
          <a class="egat__piece-link" href="{{ product.url }}">
            <div class="egat__piece-media">
              {%- if product.featured_image != blank -%}
                {{ product.featured_image | image_url: width: 1000 | image_tag:
                   loading: 'lazy', sizes: '(min-width: 750px) 29vw, 90vw',
                   widths: '400, 600, 800, 1000',
                   class: 'egat__piece-img', alt: product.title }}
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'egat__piece-img' }}
              {%- endif -%}
            </div>
            <p class="egat__piece-label">{{ product.title }}</p>
          </a>
        </li>
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..product_limit) -%}
        <li class="egat__piece">
          <div class="egat__piece-media">{{ 'product-2' | placeholder_svg_tag: 'egat__piece-img' }}</div>
          <p class="egat__piece-label">Collection Item Name</p>
        </li>
      {%- endfor -%}
    {%- endif -%}
  </ul>

  {%- if link_label != blank -%}
    <div class="egat__more">
      <a class="egat__more-link" href="{% if c != blank %}{{ c.url }}{% else %}#{% endif %}">{{ link_label }}</a>
    </div>
  {%- endif -%}
</div>

{%- style -%}
  .egat { color: var(--eg-ink, #1a1a1a); }

  .egat__heading {
    margin: 0 0 clamp(2.5rem, 5vw, 4.5rem);
    padding: 0 1.5rem;
    text-align: center;
    font-family: var(--eg-serif, 'Cormorant Garamond', serif);
    font-weight: 400;
    font-size: clamp(1.9rem, 3vw, 3rem);
  }

  .egat__film {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #111;
  }
  .egat__fill {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .egat__intro {
    display: grid;
    grid-template-columns: 30% 1fr;
    gap: 2rem;
    padding: clamp(3rem, 6vw, 5.5rem) 8% clamp(3rem, 6vw, 5rem);
  }
  .egat__name {
    margin: 0 0 0.4rem;
    font-family: var(--eg-serif, 'Cormorant Garamond', serif);
    font-weight: 400;
    font-size: clamp(1.35rem, 1.8vw, 1.85rem);
    line-height: 1.2;
  }
  .egat__role {
    margin: 0;
    font-family: var(--eg-sans, Inter, sans-serif);
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    opacity: 0.8;
  }
  .egat__story {
    max-width: 42rem;
    font-family: var(--eg-serif, 'Cormorant Garamond', serif);
    font-size: clamp(1rem, 1.1vw, 1.12rem);
    line-height: 1.55;
  }
  .egat__story p { margin: 0; }
  .egat__story p + p { margin-top: 1em; }

  .egat__work {
    list-style: none;
    margin: 0;
    padding: 0 6.5%;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.4%;
  }
  .egat__piece-link {
    display: block;
    color: inherit;
    text-decoration: none;
  }
  .egat__piece-media {
    position: relative;
    aspect-ratio: 7 / 8;
    overflow: hidden;
    background: #e9e8e6;
  }
  .egat__piece-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    transition: transform 1.4s var(--eg-ease, cubic-bezier(0.22, 1, 0.36, 1));
  }
  .egat__piece-link:hover .egat__piece-img { transform: scale(1.03); }
  .egat__piece-label {
    margin: 1rem 0 0;
    text-align: center;
    font-family: var(--eg-sans, Inter, sans-serif);
    font-size: 0.66rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .egat__more {
    margin-top: clamp(2rem, 3.5vw, 3rem);
    text-align: center;
  }
  .egat__more-link {
    display: inline-block;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid currentColor;
    font-family: var(--eg-sans, Inter, sans-serif);
    font-size: 0.66rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: inherit;
    text-decoration: none;
    transition: opacity 0.3s ease;
  }
  .egat__more-link:hover { opacity: 0.55; }

  @media screen and (max-width: 749px) {
    .egat__film { aspect-ratio: 4 / 5; }
    .egat__intro { grid-template-columns: 1fr; gap: 1.25rem; padding-left: 1.5rem; padding-right: 1.5rem; }
    .egat__work { grid-template-columns: 1fr; gap: 2rem; padding: 0 1.5rem; }
  }
{%- endstyle -%}

{% schema %}
{
  "name": "EG Inside the Atelier",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "paragraph", "content": "Simon's sections 06 and 07. Featured artisan film and story, then three pieces from their collection." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Inside the Atelier" },
    { "type": "video", "id": "video", "label": "Studio film (MP4)" },
    { "type": "image_picker", "id": "poster", "label": "Still image", "info": "Shows if no film is uploaded." },
    { "type": "header", "content": "Artisan" },
    { "type": "collection", "id": "collection", "label": "Artisan collection", "info": "Their products show below, and the link goes to this collection." },
    { "type": "text", "id": "name", "label": "Name", "info": "Leave blank to use the collection's artisan name." },
    { "type": "text", "id": "role", "label": "Role", "default": "Ceramicist & Glaze Artist" },
    { "type": "richtext", "id": "story", "label": "Story", "info": "Leave blank to use the collection's artisan story." },
    { "type": "header", "content": "Their work" },
    { "type": "image_picker", "id": "portrait", "label": "Artisan portrait", "info": "Optional. Replaces the first product with a portrait (Simon's alternate)." },
    { "type": "text", "id": "portrait_label", "label": "Portrait label", "default": "Artist Portrait" },
    { "type": "text", "id": "link_label", "label": "Link text", "default": "Explore Entire Collection", "info": "Type [name] to insert the artisan's name, e.g. Discover [name]'s Collection" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "pad_top", "min": 0, "max": 16, "step": 1, "unit": "rem", "label": "Space above", "default": 7 },
    { "type": "range", "id": "pad_bottom", "min": 0, "max": 16, "step": 1, "unit": "rem", "label": "Space below", "default": 7 }
  ],
  "presets": [ { "name": "EG Inside the Atelier" } ]
}
{% endschema %}