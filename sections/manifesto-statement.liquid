{%- liquid
  assign eyebrow = section.settings.eyebrow
  assign statement = section.settings.statement
  assign attribution = section.settings.attribution
-%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="eg-manifesto section-{{ section.id }}-padding">
    <div class="eg-manifesto__inner page-width">
      {%- if eyebrow != blank -%}
        <span class="eg-manifesto__eyebrow">{{ eyebrow }}</span>
      {%- endif -%}
      {%- if statement != blank -%}
        <p class="eg-manifesto__statement">{{ statement | newline_to_br }}</p>
      {%- endif -%}
      {%- if attribution != blank -%}
        <span class="eg-manifesto__attribution">— {{ attribution }}</span>
      {%- endif -%}
    </div>
  </div>
</div>

{%- style -%}
  .section-{{ section.id }}-padding { padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px; padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px; }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding { padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; }
  }
  .eg-manifesto__inner { max-width: 900px; margin: 0 auto; text-align: center; display: flex; flex-direction: column; align-items: center; gap: 1.5rem; color: rgb(var(--color-foreground)); }
  .eg-manifesto__eyebrow { font-family: var(--font-body-family); font-size: 0.7rem; letter-spacing: 0.28em; text-transform: uppercase; opacity: 0.55; }
  .eg-manifesto__statement { font-family: var(--font-heading-family); font-weight: 300; font-style: italic; font-size: clamp(1.5rem, 2.6vw, 2.25rem); line-height: 1.3; letter-spacing: -0.005em; margin: 0; }
  .eg-manifesto__attribution { font-family: var(--font-body-family); font-size: 0.72rem; letter-spacing: 0.22em; text-transform: uppercase; opacity: 0.65; }
{%- endstyle -%}

{% schema %}
{
  "name": "Manifesto Statement",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our Standard" },
    { "type": "textarea", "id": "statement", "label": "Statement", "default": "The market doesn't lack beautiful things. It lacks a name willing to stand behind the artisans who make them." },
    { "type": "text", "id": "attribution", "label": "Attribution", "default": "Eugenia Grace" },
    { "type": "header", "content": "Appearance" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-2" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 112 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 112 }
  ],
  "presets": [
    { "name": "Manifesto Statement" }
  ]
}
{% endschema %}