<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="eg-pair section-{{ section.id }}-padding">
    <div class="eg-pair__inner page-width">
      <div class="eg-pair__grid">
        {%- for block in section.blocks -%}
          <a href="{{ block.settings.link | default: '#' }}" class="eg-pair__card" {{ block.shopify_attributes }}>
            <div class="eg-pair__media">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 1200 | image_tag:
                  loading: 'lazy',
                  widths: '500, 800, 1000, 1200',
                  sizes: '(min-width: 990px) 45vw, 90vw',
                  alt: block.settings.name | default: '' | escape
                }}
              {%- else -%}
                {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>
            <div class="eg-pair__body">
              {%- if block.settings.name != blank -%}
                <h3 class="eg-pair__name">{{ block.settings.name }}</h3>
              {%- endif -%}
              {%- if block.settings.tagline != blank -%}
                <p class="eg-pair__tagline">{{ block.settings.tagline }}</p>
              {%- endif -%}
              {%- if block.settings.link_label != blank -%}
                <span class="eg-pair__link">{{ block.settings.link_label }}</span>
              {%- endif -%}
            </div>
          </a>
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .eg-pair__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 4vw, 4rem);
  }

  .eg-pair__card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: rgb(var(--color-foreground));
    transition: opacity 0.3s ease;
  }
  .eg-pair__card:hover { opacity: 0.88; }

  .eg-pair__card:nth-child(2) { margin-top: 3rem; }

  .eg-pair__media {
    width: 100%;
    overflow: hidden;
    margin-bottom: 1.25rem;
  }
  .eg-pair__media img,
  .eg-pair__media svg {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    display: block;
    transition: transform 1s cubic-bezier(.2,.7,.2,1);
  }
  .eg-pair__card:hover .eg-pair__media img { transform: scale(1.03); }

  .eg-pair__name {
    font-family: var(--font-heading-family);
    font-weight: 300;
    font-size: clamp(1.25rem, 1.8vw, 1.5rem);
    margin: 0 0 0.4rem;
  }
  .eg-pair__tagline {
    font-family: var(--font-heading-family);
    font-style: italic;
    font-size: 0.9rem;
    opacity: 0.7;
    margin: 0 0 0.65rem;
  }
  .eg-pair__link {
    font-family: var(--font-body-family);
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    border-bottom: 1px solid currentColor;
    padding-bottom: 0.25rem;
    align-self: flex-start;
  }

  @media screen and (max-width: 749px) {
    .eg-pair__grid { grid-template-columns: 1fr; gap: 2rem; }
    .eg-pair__card:nth-child(2) { margin-top: 0; }
  }
{%- endstyle -%}

{% schema %}
{
  "name": "Artisan Pair",
  "tag": "section",
  "class": "section section-eg-pair",
  "max_blocks": 2,
  "settings": [
    { "type": "header", "content": "Appearance" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 96 }
  ],
  "blocks": [
    {
      "type": "artisan",
      "name": "Artisan",
      "limit": 2,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Portrait (4:5)" },
        { "type": "text", "id": "name", "label": "Artisan name", "default": "Artisan Name" },
        { "type": "text", "id": "tagline", "label": "Italic tagline", "default": "A defining quality" },
        { "type": "text", "id": "link_label", "label": "Link label", "default": "Shop pre-fall" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Artisan Pair",
      "blocks": [
        { "type": "artisan" }, { "type": "artisan" }
      ]
    }
  ]
}
{% endschema %}