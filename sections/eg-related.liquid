<section class="egrel eg-reveal">
  {%- if section.settings.heading != blank -%}
    <p class="eg-eyebrow egrel__head">{{ section.settings.heading }}</p>
  {%- endif -%}
  <div class="egrel__grid">
    {%- assign rec_limit = section.settings.count -%}
    {%- if recommendations.performed and recommendations.products_count > 0 -%}
      {%- for product in recommendations.products limit: rec_limit -%}
        <a href="{{ product.url }}" class="egrel__card eg-hover-zoom">
          <div class="egrel__media">
            {%- if product.featured_media -%}
              {{ product.featured_media | image_url: width: 800 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 24vw, 45vw', widths: '300,450,600,800', alt: product.title }}
            {%- else -%}
              {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>
          <div class="egrel__info">
            <span class="egrel__name">{{ product.title }}</span>
            <span class="egrel__price">{{ product.price | money }}</span>
          </div>
        </a>
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..rec_limit) -%}
        <div class="egrel__card"><div class="egrel__media">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</div></div>
      {%- endfor -%}
    {%- endif -%}
  </div>
</section>

{%- style -%}
  .egrel { padding: clamp(3.5rem, 7vw, 7rem) clamp(1.5rem, 4vw, 4rem); background: #FFFFFF; }
  .egrel__head { text-align: left; color: #6E6E6E; margin-bottom: clamp(2rem, 3vw, 3rem); }
  .egrel__grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: clamp(1.25rem, 2.5vw, 2.5rem); }
  .egrel__card { display: block; text-decoration: none; color: #1A1A1A; }
  .egrel__media { overflow: hidden; margin-bottom: 1rem; }
  .egrel__media img, .egrel__media svg { width: 100%; height: 100%; object-fit: cover; display: block; aspect-ratio: 1 / 1; }
  .egrel__info { display: flex; flex-direction: column; gap: 0.35rem; }
  .egrel__name { font-family: var(--eg-serif); font-weight: 400; font-size: 1.1rem; }
  .egrel__price { font-family: var(--eg-sans); font-size: 0.85rem; color: #6E6E6E; letter-spacing: 0.03em; }
  @media screen and (max-width: 749px) {
    .egrel__grid { grid-template-columns: 1fr 1fr; }
  }
{%- endstyle -%}

{% schema %}
{
  "name": "EG Related Products",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "You May Also Like" },
    { "type": "range", "id": "count", "label": "Number of products", "min": 2, "max": 8, "step": 1, "default": 4 },
    { "type": "paragraph", "content": "Uses Shopify's automatic product recommendations. Requires the Search & Discovery app for best results." }
  ],
  "presets": [ { "name": "EG Related Products" } ]
}
{% endschema %}