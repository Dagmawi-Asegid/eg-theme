{%- liquid
  assign col = section.settings.collection
-%}

{%- if col != blank and col.products_count > 0 -%}
<section class="egrow eg-reveal">
  {%- if section.settings.heading != blank -%}
    <div class="egrow__head">
      <p class="eg-eyebrow">{{ section.settings.heading }}</p>
    </div>
  {%- endif -%}
  <div class="egrow__track">
    {%- for product in col.products limit: section.settings.count -%}
      <a href="{{ product.url }}" class="egrow__card eg-hover-zoom">
        <div class="egrow__media">
          {%- if product.featured_media -%}
            {{ product.featured_media | image_url: width: 700 | image_tag: loading: 'lazy', widths: '250,400,550,700', sizes: '(min-width: 750px) 18vw, 45vw', alt: product.title }}
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>
        <span class="egrow__name">{{ product.title }}</span>
        <span class="egrow__price">{{ product.price | money }}</span>
      </a>
    {%- endfor -%}
  </div>
</section>
{%- endif -%}

{%- style -%}
  .egrow { padding: clamp(3.5rem, 6vw, 6rem) 0; background: #FFFFFF; }
  .egrow__head { text-align: center; margin-bottom: clamp(2rem, 4vw, 3.5rem); }
  .egrow__head .eg-eyebrow { color: #1A1A1A; }
  .egrow__track {
    display: flex; gap: clamp(1.25rem, 2.5vw, 2.5rem);
    overflow-x: auto; scroll-snap-type: x mandatory;
    padding: 0 clamp(1.5rem, 4vw, 4rem);
    -webkit-overflow-scrolling: touch;
  }
  .egrow__track::-webkit-scrollbar { height: 0; }
  .egrow__card {
    flex: 0 0 clamp(200px, 18vw, 260px);
    scroll-snap-align: start;
    text-decoration: none; color: #1A1A1A;
    display: flex; flex-direction: column; gap: 0.5rem;
  }
  .egrow__media { overflow: hidden; margin-bottom: 0.5rem; }
  .egrow__media img, .egrow__media svg { width: 100%; height: 100%; object-fit: cover; display: block; aspect-ratio: 1 / 1; }
  .egrow__name { font-family: var(--eg-serif); font-weight: 400; font-size: 1.05rem; }
  .egrow__price { font-family: var(--eg-sans); font-size: 0.82rem; color: #6E6E6E; letter-spacing: 0.03em; }
  @media screen and (max-width: 749px) {
    .egrow__card { flex: 0 0 44vw; }
  }
{%- endstyle -%}

{% schema %}
{
  "name": "EG Artist Row",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "More From The Artist" },
    { "type": "collection", "id": "collection", "label": "Artist's collection" },
    { "type": "range", "id": "count", "label": "Max products", "min": 3, "max": 12, "step": 1, "default": 6 },
    { "type": "paragraph", "content": "Pick the artisan's collection. Their pieces auto-populate. Hides if empty." }
  ],
  "presets": [ { "name": "EG Artist Row" } ]
}
{% endschema %}