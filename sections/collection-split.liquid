{%- liquid
  assign headline = section.settings.headline
  assign subtitle = section.settings.subtitle
  assign collage_image = section.settings.collage_image
  assign product_image = section.settings.product_image
  assign cta_label = section.settings.cta_label
  assign cta_url = section.settings.cta_url
-%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="eg-split section-{{ section.id }}-padding">
    <div class="eg-split__inner page-width">

      <div class="eg-split__collage">
        {%- if collage_image != blank -%}
          {{ collage_image | image_url: width: 1200 | image_tag:
            loading: 'lazy',
            widths: '600, 900, 1200',
            sizes: '(min-width: 990px) 55vw, 100vw',
            alt: ''
          }}
        {%- else -%}
          {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>

      <div class="eg-split__content">
        {%- if headline != blank -%}
          <h2 class="eg-split__headline">{{ headline }}</h2>
        {%- endif -%}
        {%- if subtitle != blank -%}
          <p class="eg-split__subtitle">{{ subtitle }}</p>
        {%- endif -%}

        <div class="eg-split__product">
          {%- if product_image != blank -%}
            {{ product_image | image_url: width: 600 | image_tag:
              loading: 'lazy',
              widths: '300, 450, 600',
              sizes: '320px',
              alt: ''
            }}
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>

        {%- if cta_label != blank -%}
          <a href="{{ cta_url | default: '#' }}" class="eg-split__cta">
            <span>{{ cta_label }}</span>
            <span aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="0.75">
                <circle cx="11" cy="11" r="10.5"/>
                <path d="M9 7l5 4-5 4" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </a>
        {%- endif -%}
      </div>

    </div>
  </div>
</div>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .eg-split__inner {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: clamp(2rem, 4vw, 4.5rem);
    align-items: center;
  }

  .eg-split__collage img,
  .eg-split__collage svg {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
  }

  .eg-split__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
    color: rgb(var(--color-foreground));
  }

  .eg-split__headline {
    font-family: var(--font-heading-family);
    font-weight: 300;
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    line-height: 1.1;
    letter-spacing: -0.01em;
    margin: 0;
  }

  .eg-split__subtitle {
    font-family: var(--font-body-family);
    font-size: 0.85rem;
    opacity: 0.7;
    margin: 0 0 1rem;
  }

  .eg-split__product {
    width: 320px;
    max-width: 100%;
    margin-bottom: 1.25rem;
  }
  .eg-split__product img,
  .eg-split__product svg {
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    display: block;
  }

  .eg-split__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.9rem 1.6rem;
    background: rgb(var(--color-foreground));
    color: rgb(var(--color-background));
    font-family: var(--font-body-family);
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-decoration: none;
    transition: opacity 0.3s ease, gap 0.3s ease;
  }
  .eg-split__cta:hover { gap: 1.15rem; opacity: 0.88; }

  @media screen and (max-width: 749px) {
    .eg-split__inner { grid-template-columns: 1fr; gap: 2rem; }
    .eg-split__product { width: 220px; }
  }
{%- endstyle -%}

{% schema %}
{
  "name": "Collection Split",
  "tag": "section",
  "class": "section section-eg-split",
  "settings": [
    { "type": "header", "content": "Left collage" },
    { "type": "image_picker", "id": "collage_image", "label": "Collage image (landscape 4:3)" },
    { "type": "header", "content": "Right content" },
    { "type": "text", "id": "headline", "label": "Headline", "default": "New Nights" },
    { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "New collections arriving in the fall" },
    { "type": "image_picker", "id": "product_image", "label": "Product image (square)" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Explore" },
    { "type": "url", "id": "cta_url", "label": "Button link" },
    { "type": "header", "content": "Appearance" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 96 }
  ],
  "presets": [
    { "name": "Collection Split" }
  ]
}
{% endschema %}