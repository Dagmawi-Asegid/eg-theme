{%- comment -%}
  EG Brand Film — sections/eg-film.liquid
  Simon layout 01. Full-width film, almost no messaging.
  Upload the MP4 in "Film". The still image shows while it loads,
  and replaces the film if no video is uploaded.
{%- endcomment -%}

<div class="egfilm egfilm--{{ section.settings.size }}{% if section.settings.label != blank %} egfilm--labelled{% endif %}">
  <div class="egfilm__media">
    {%- if section.settings.video != blank -%}
      {{ section.settings.video | video_tag:
         autoplay: true, loop: true, muted: true, controls: false,
         image_size: '2000x', class: 'egfilm__fill' }}
    {%- elsif section.settings.poster != blank -%}
      {{ section.settings.poster | image_url: width: 3000 | image_tag:
         loading: 'eager', fetchpriority: 'high', sizes: '100vw',
         widths: '750, 1100, 1500, 2000, 3000',
         class: 'egfilm__fill', alt: '' }}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'egfilm__fill egfilm__placeholder' }}
    {%- endif -%}
  </div>

  {%- if section.settings.label != blank -%}
    {%- if section.settings.label_link != blank -%}
      <a class="egfilm__label" href="{{ section.settings.label_link }}">{{ section.settings.label }}</a>
    {%- else -%}
      <p class="egfilm__label">{{ section.settings.label }}</p>
    {%- endif -%}
  {%- endif -%}
</div>

{%- style -%}
  .egfilm {
    position: relative;
    overflow: hidden;
    background: #111;
  }
  .egfilm--wide { aspect-ratio: 16 / 9; }
  .egfilm--cinema { aspect-ratio: 21 / 9; }
  .egfilm--full { height: 100svh; }

  .egfilm__media,
  .egfilm__fill {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .egfilm__fill {
    display: block;
    object-fit: cover;
  }
  .egfilm__placeholder { background: #d9d6d3; }

  .egfilm--labelled::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 35%;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.3), rgba(0, 0, 0, 0));
    pointer-events: none;
  }

  .egfilm__label {
    position: absolute;
    left: var(--eg-gutter, 4rem);
    bottom: clamp(1.5rem, 5vw, 4rem);
    z-index: 2;
    margin: 0;
    padding-bottom: 0.45rem;
    border-bottom: 1px solid currentColor;
    color: #fff;
    font-family: var(--eg-sans, Inter, sans-serif);
    font-size: 0.68rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    text-decoration: none;
  }

  @media screen and (max-width: 749px) {
    .egfilm--wide,
    .egfilm--cinema { aspect-ratio: 4 / 5; }
    .egfilm__label { left: 1.5rem; }
  }
{%- endstyle -%}

{% schema %}
{
  "name": "EG Brand Film",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "paragraph", "content": "Simon's section 01. Full-width film with almost no text." },
    { "type": "video", "id": "video", "label": "Film (MP4)", "info": "Plays muted on a loop. Keep it under 20MB, 10 to 20 seconds." },
    { "type": "image_picker", "id": "poster", "label": "Still image", "info": "Shows if no film is uploaded." },
    { "type": "select", "id": "size", "label": "Height", "options": [
      { "value": "wide", "label": "Wide (16:9)" },
      { "value": "cinema", "label": "Cinema (21:9)" },
      { "value": "full", "label": "Full screen" }
    ], "default": "wide" },
    { "type": "header", "content": "Label" },
    { "type": "text", "id": "label", "label": "Label text", "default": "Collection Name", "info": "Small text bottom left. Leave blank to hide." },
    { "type": "url", "id": "label_link", "label": "Label link" }
  ],
  "presets": [ { "name": "EG Brand Film" } ]
}
{% endschema %}