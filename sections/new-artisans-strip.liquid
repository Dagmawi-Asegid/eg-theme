{%- liquid
  assign eyebrow_count = section.settings.eyebrow_count
  assign headline = section.settings.headline
  assign subtitle = section.settings.subtitle
  assign cta_label = section.settings.cta_label
  assign cta_url = section.settings.cta_url
-%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="eg-artisans section-{{ section.id }}-padding">
    <div class="eg-artisans__inner page-width">

      <div class="eg-artisans__intro">
        {%- if eyebrow_count != blank -%}
          <span class="eg-artisans__eyebrow">{{ eyebrow_count }}</span>
        {%- endif -%}
        {%- if headline != blank -%}
          <h2 class="eg-artisans__headline">{{ headline }}</h2>
        {%- endif -%}
        {%- if subtitle != blank -%}
          <p class="eg-artisans__subtitle">{{ subtitle }}</p>
        {%- endif -%}
        {%- if cta_label != blank -%}
          <a href="{{ cta_url | default: '#' }}" class="eg-artisans__cta">
            <span>{{ cta_label }}</span>
            <span class="eg-artisans__cta-arrow" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="0.75">
                <circle cx="11" cy="11" r="10.5"/>
                <path d="M9 7l5 4-5 4" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </a>
        {%- endif -%}
      </div>

      <div class="eg-artisans__grid">
        {%- for block in section.blocks -%}
          <a href="{{ block.settings.link | default: '#' }}" class="eg-artisans__card" {{ block.shopify_attributes }}>
            <div class="eg-artisans__card-media">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 600 | image_tag:
                  loading: 'lazy',
                  widths: '300, 450, 600',
                  sizes: '(min-width: 990px) 18vw, 33vw',
                  alt: block.settings.name | default: '' | escape
                }}
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>
            {%- if block.settings.name != blank -%}
              <span class="eg-artisans__card-name">{{ block.settings.name }}</span>
            {%- endif -%}
          </a>
        {%- endfor -%}
      </div>

    </div>
  </div>
</div>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .eg-artisans__inner {
    display: grid;
    grid-template-columns: 1fr 2.2fr;
    gap: clamp(2rem, 4vw, 5rem);
    align-items: center;
  }

  .eg-artisans__intro {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .eg-artisans__eyebrow {
    font-family: var(--font-body-family);
    font-size: 0.7rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    opacity: 0.6;
    color: rgb(var(--color-foreground));
  }

  .eg-artisans__headline {
    font-family: var(--font-heading-family);
    font-weight: 300;
    font-size: clamp(1.75rem, 2.8vw, 2.5rem);
    line-height: 1.1;
    letter-spacing: -0.01em;
    margin: 0;
    color: rgb(var(--color-foreground));
  }

  .eg-artisans__subtitle {
    font-family: var(--font-body-family);
    font-size: 0.85rem;
    margin: 0 0 0.5rem;
    opacity: 0.7;
    color: rgb(var(--color-foreground));
  }

  .eg-artisans__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.9rem 1.6rem;
    background: rgb(var(--color-foreground));
    color: rgb(var(--color-background));
    font-family: var(--font-body-family);
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-decoration: none;
    transition: opacity 0.3s ease, gap 0.3s ease;
    border: 1px solid rgb(var(--color-foreground));
  }
  .eg-artisans__cta:hover { gap: 1.15rem; opacity: 0.88; }
  .eg-artisans__cta-arrow { display: inline-flex; }

  .eg-artisans__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1rem, 2vw, 2rem);
  }

  .eg-artisans__card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    text-decoration: none;
    color: rgb(var(--color-foreground));
    transition: opacity 0.3s ease;
  }
  .eg-artisans__card:hover { opacity: 0.82; }

  .eg-artisans__card-media {
    width: 100%;
    overflow: hidden;
  }
  .eg-artisans__card-media img,
  .eg-artisans__card-media svg {
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    display: block;
    transition: transform 0.9s cubic-bezier(.2,.7,.2,1);
  }
  .eg-artisans__card:hover .eg-artisans__card-media img {
    transform: scale(1.04);
  }

  .eg-artisans__card-name {
    font-family: var(--font-body-family);
    font-size: 0.7rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    text-align: center;
  }

  @media screen and (max-width: 749px) {
    .eg-artisans__inner {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .eg-artisans__grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 0.75rem;
    }
    .eg-artisans__card-name {
      font-size: 0.6rem;
      letter-spacing: 0.16em;
    }
  }
{%- endstyle -%}

{% schema %}
{
  "name": "New Artisans Strip",
  "tag": "section",
  "class": "section section-eg-artisans",
  "max_blocks": 6,
  "settings": [
    { "type": "header", "content": "Intro" },
    { "type": "text", "id": "eyebrow_count", "label": "Eyebrow text", "default": "12 New Artisans" },
    { "type": "text", "id": "headline", "label": "Headline", "default": "Find your next muse" },
    { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Browse the latest" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Shop Now" },
    { "type": "url", "id": "cta_url", "label": "Button link" },
    { "type": "header", "content": "Appearance" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 72 }
  ],
  "blocks": [
    {
      "type": "artisan_card",
      "name": "Artisan",
      "limit": 6,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Artisan image" },
        { "type": "text", "id": "name", "label": "Artisan name", "default": "Artisan Name" },
        { "type": "url", "id": "link", "label": "Link to artisan or collection" }
      ]
    }
  ],
  "presets": [
    {
      "name": "New Artisans Strip",
      "blocks": [
        { "type": "artisan_card" },
        { "type": "artisan_card" },
        { "type": "artisan_card" }
      ]
    }
  ]
}
{% endschema %}