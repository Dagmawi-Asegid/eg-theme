/* ============================================================
   EG — Filter drawer (clean)
   ============================================================ */

/* Bar above the grid */
.facets-container {
  padding: 1.6rem var(--eg-gutter, clamp(1.5rem, 5vw, 5rem)) !important;
  border-top: 1px solid var(--eg-hairline, rgba(26,26,26,0.14)) !important;
  border-bottom: 1px solid var(--eg-hairline, rgba(26,26,26,0.14)) !important;
  margin-bottom: clamp(2.5rem, 6vw, 5rem) !important;
  gap: 2rem !important;
  flex-wrap: nowrap !important;
}

.mobile-facets__open,
.facet-filters__label,
.facet-filters__sort,
.product-count__text {
  font-family: var(--eg-sans, Inter, sans-serif) !important;
  font-size: 0.72rem !important;
  letter-spacing: 0.2em !important;
  text-transform: uppercase !important;
  font-weight: 400 !important;
  white-space: nowrap !important;
}

.mobile-facets__open {
  display: inline-flex !important;
  align-items: center !important;
  gap: 0.85rem !important;
  padding: 0 !important;
  border: 0 !important;
  background: none !important;
}
.mobile-facets__open svg { display: none !important; }
.mobile-facets__open::before {
  content: '';
  width: 13px; height: 13px; flex: 0 0 13px;
  background:
    linear-gradient(currentColor,currentColor) center/100% 1px no-repeat,
    linear-gradient(currentColor,currentColor) center/1px 100% no-repeat;
}

.product-count__text { opacity: 0.5 !important; }
.facet-filters select {
  appearance: none !important;
  background: none !important;
  border: 0 !important;
  padding: 0 1.2rem 0 0 !important;
  box-shadow: none !important;
}

/* ---- Drawer overlay: must sit ABOVE the sticky header ---- */
.mobile-facets__wrapper { position: static !important; }

.mobile-facets {
  position: fixed !important;
  inset: 0 !important;
  width: 100% !important;
  max-width: none !important;
  height: 100dvh !important;
  margin: 0 !important;
  padding: 0 !important;
  border: 0 !important;
  background: rgba(26,26,26,0.3) !important;
  display: flex !important;
  justify-content: flex-end !important;
  z-index: 99999 !important;
}

.mobile-facets__inner {
  width: min(400px, 100vw) !important;
  max-width: min(400px, 100vw) !important;
  height: 100% !important;
  margin: 0 0 0 auto !important;
  padding: 0 !important;
  background: #fff !important;
  display: flex !important;
  flex-direction: column !important;
  border: 0 !important;
  box-shadow: none !important;
}

.mobile-facets__header {
  flex: 0 0 auto !important;
  padding: 2.5rem 2.25rem 1.25rem !important;
  border-bottom: 0 !important;
  background: #fff !important;
}
.mobile-facets__heading {
  font-family: var(--eg-serif, 'Cormorant Garamond', serif) !important;
  font-weight: 300 !important;
  font-size: 1.9rem !important;
  text-transform: none !important;
  letter-spacing: 0.02em !important;
}

.mobile-facets__main {
  flex: 1 1 auto !important;
  overflow-y: auto !important;
  padding: 0 2.25rem !important;
}

/* Kill the accordion — with one filter, show values immediately */
.mobile-facets__details { border: 0 !important; }
.mobile-facets__summary { display: none !important; }
.mobile-facets__details > *,
.mobile-facets__submenu,
.mobile-facets__list {
  display: block !important;
  height: auto !important;
  visibility: visible !important;
}

/* Filter values */
.mobile-facets__item { padding: 0 !important; }
.mobile-facets__label {
  display: flex !important;
  align-items: center !important;
  gap: 0.85rem !important;
  padding: 0.65rem 0 !important;
  font-family: var(--eg-sans, Inter, sans-serif) !important;
  font-size: 0.95rem !important;
  text-transform: none !important;
  background: none !important;
}
.mobile-facets__label svg,
.mobile-facets__label .icon-checkmark { display: none !important; }
.mobile-facets__checkbox { position: absolute !important; opacity: 0 !important; }
.mobile-facets__label::before {
  content: '';
  width: 5px; height: 5px; flex: 0 0 5px;
  border-radius: 50%;
  background: transparent;
  transition: background 0.3s ease;
}
.mobile-facets__label:has(input:checked)::before {
  background: var(--eg-aubergine, #5b2545);
}
.mobile-facets__label:has(input:checked) {
  text-decoration: underline;
  text-underline-offset: 4px;
  text-decoration-color: var(--eg-aubergine, #5b2545);
}

/* Footer */
.mobile-facets__footer {
  flex: 0 0 auto !important;
  display: flex !important;
  align-items: center !important;
  justify-content: space-between !important;
  gap: 1.25rem !important;
  padding: 1.5rem 2.25rem 2.25rem !important;
  border-top: 1px solid var(--eg-hairline, rgba(26,26,26,0.14)) !important;
  background: #fff !important;
}
.mobile-facets__clear {
  border: 0 !important;
  text-decoration: none !important;
  opacity: 0.45;
  font-size: 0.7rem !important;
  letter-spacing: 0.18em !important;
  text-transform: uppercase !important;
}
.mobile-facets__footer .button {
  background: var(--eg-ink, #1a1a1a) !important;
  color: #fff !important;
  border: 0 !important;
  border-radius: 0 !important;
  box-shadow: none !important;
  padding: 0.9rem 2.25rem !important;
  min-height: 0 !important;
  font-size: 0.7rem !important;
  letter-spacing: 0.2em !important;
  text-transform: uppercase !important;
}
.mobile-facets__footer .button::after { display: none !important; }

@media screen and (max-width: 749px) {
  .mobile-facets__inner { width: 100vw !important; max-width: 100vw !important; }
  .mobile-facets__header,
  .mobile-facets__main,
  .mobile-facets__footer { padding-left: 1.5rem !important; padding-right: 1.5rem !important; }
}