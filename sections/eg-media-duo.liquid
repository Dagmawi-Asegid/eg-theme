<section class="egduo eg-reveal">
  <div class="egduo__grid egduo__grid--{{ section.blocks.size }}">
    {%- for block in section.blocks -%}
      <a href="{{ block.settings.link | default: '#' }}" class="egduo__tile eg-hover-zoom" {{ block.shopify_attributes }}>
        <div class="egduo__media">
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 50vw, 100vw', widths: '600,900,1200,1600', alt: block.settings.heading }}
          {%- else -%}
            {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>
        <div class="egduo__content egduo__content--{{ block.settings.tone }}">
          {%- if block.settings.eyebrow != blank -%}<p class="eg-eyebrow">{{ block.settings.eyebrow }}</p>{%- endif -%}
          {%- if block.settings.heading != blank -%}<h2 class="eg-h2">{{ block.settings.heading }}</h2>{%- endif -%}
          {%- if block.settings.cta_label != blank -%}<span class="eg-link">{{ block.settings.cta_label }}</span>{%- endif -%}
        </div>
      </a>
    {%- endfor -%}
  </div>
</section>

{%- style -%}
  .egduo__grid { display: grid; gap: var(--eg-gap); }
  .egduo__grid--2 { grid-template-columns: 1fr 1fr; }
  .egduo__grid--1 { grid-template-columns: 1fr; }
  .egduo__tile { position: relative; display: block; text-decoration: none; }
  .egduo__media img, .egduo__media svg {
    width: 100%; height: 100%; object-fit: cover; display: block;
    aspect-ratio: {{ section.settings.ratio }};
  }
  .egduo__content {
    position: absolute; z-index: 2;
    left: clamp(1.25rem, 3vw, 3rem); bottom: clamp(1.25rem, 3vw, 2.75rem);
    display: flex; flex-direction: column; gap: 0.9rem; align-items: flex-start;
    max-width: 40ch;
  }
  .egduo__content--light { color: #FFF; text-shadow: 0 1px 16px rgba(0,0,0,0.3); }
  .egduo__content--dark { color: #111; }
  @media screen and (max-width: 749px) {
    .egduo__grid--2 { grid-template-columns: 1fr; }
  }
{%- endstyle -%}

{% schema %}
{
  "name": "EG Media Duo",
  "tag": "section",
  "class": "section",
  "max_blocks": 2,
  "settings": [
    {
      "type": "select",
      "id": "ratio",
      "label": "Tile aspect ratio",
      "options": [
        { "value": "4 / 5", "label": "Portrait 4:5" },
        { "value": "1 / 1", "label": "Square" },
        { "value": "4 / 3", "label": "Landscape 4:3" },
        { "value": "16 / 9", "label": "Wide 16:9" }
      ],
      "default": "4 / 5"
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "limit": 2,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "text", "id": "cta_label", "label": "Link label", "default": "Discover" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "select", "id": "tone", "label": "Text color", "options": [
          { "value": "light", "label": "Light" }, { "value": "dark", "label": "Dark" }
        ], "default": "light" }
      ]
    }
  ],
  "presets": [
    { "name": "EG Media Duo", "blocks": [ { "type": "tile" }, { "type": "tile" } ] }
  ]
}
{% endschema %}