<section class="egcol eg-reveal">
  {%- if section.settings.heading != blank -%}
    <div class="egcol__head">
      <h2 class="eg-h2">{{ section.settings.heading }}</h2>
    </div>
  {%- endif -%}
  <div class="egcol__grid" style="--egcol-n: {{ section.blocks.size | at_least: 1 }};">
    {%- for block in section.blocks -%}
      {%- assign col = block.settings.collection -%}
      <a href="{{ col.url | default: '#' }}" class="egcol__tile eg-hover-zoom" {{ block.shopify_attributes }}>
        <div class="egcol__media">
          {%- assign img = block.settings.custom_image | default: col.featured_image -%}
          {%- if img != blank -%}
            {{ img | image_url: width: 1200 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 33vw, 100vw', widths: '400,600,900,1200', alt: col.title }}
          {%- else -%}
            {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>
        <div class="egcol__label">
          <span class="eg-eyebrow">{{ block.settings.label_override | default: col.title | default: 'Collection' }}</span>
        </div>
      </a>
    {%- endfor -%}
  </div>
</section>

{%- style -%}
  .egcol__head { text-align: center; padding: clamp(3rem, 6vw, 5.5rem) 1.5rem clamp(2rem, 4vw, 3.5rem); }
  .egcol__grid { display: grid; grid-template-columns: repeat(var(--egcol-n), 1fr); gap: var(--eg-gap); }
  .egcol__tile { display: block; text-decoration: none; color: var(--eg-ink); }
  .egcol__media img, .egcol__media svg {
    width: 100%; height: 100%; object-fit: cover; display: block;
    aspect-ratio: 3 / 4;
  }
  .egcol__label { text-align: center; padding: 1.1rem 0 1.4rem; }
  @media screen and (max-width: 749px) {
    .egcol__grid { grid-template-columns: 1fr 1fr; }
    .egcol__label .eg-eyebrow { font-size: 0.7rem; letter-spacing: 0.22em; }
  }
{%- endstyle -%}

{% schema %}
{
  "name": "EG Collection Tiles",
  "tag": "section",
  "class": "section",
  "max_blocks": 5,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading (optional)" }
  ],
  "blocks": [
    {
      "type": "col",
      "name": "Collection",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "custom_image", "label": "Custom image (overrides collection image)" },
        { "type": "text", "id": "label_override", "label": "Label override (optional)" }
      ]
    }
  ],
  "presets": [
    { "name": "EG Collection Tiles", "blocks": [ { "type": "col" }, { "type": "col" }, { "type": "col" } ] }
  ]
}
{% endschema %}