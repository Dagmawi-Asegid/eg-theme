{%- comment -%}
  EG Newsletter — eg-newsletter.liquid
  Simon layout, section 09.
  Quote-led signup. Deliberately not a "sign up for our newsletter" box.
{%- endcomment -%}

<div class="egnl eg-reveal" style="background: {{ section.settings.bg }}; color: {{ section.settings.text_color }};">
  <div class="egnl__inner">
    {%- if section.settings.quote != blank -%}
      <p class="egnl__quote">{{ section.settings.quote }}</p>
    {%- endif -%}

    {%- if section.settings.attribution != blank -%}
      <p class="egnl__attribution">{{ section.settings.attribution }}</p>
    {%- endif -%}

    {%- if section.settings.show_form -%}
      <div class="egnl__form-wrap">
        {%- form 'customer', class: 'egnl__form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <label class="visually-hidden" for="egnl-email">{{ section.settings.placeholder }}</label>
          <input
            id="egnl-email"
            type="email"
            name="contact[email]"
            class="egnl__input"
            placeholder="{{ section.settings.placeholder }}"
            autocorrect="off"
            autocapitalize="off"
            required
          >
          <button type="submit" class="egnl__submit">
            {{ section.settings.button_label }}
          </button>

          {%- if form.errors -%}
            <p class="egnl__msg egnl__msg--error">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
          {%- endif -%}
          {%- if form.posted_successfully? -%}
            <p class="egnl__msg">{{ section.settings.success_message }}</p>
          {%- endif -%}
        {%- endform -%}
      </div>
    {%- endif -%}

    {%- if section.settings.link_label != blank -%}
      <a class="egnl__link" href="{{ section.settings.link_url }}">
        <span>{{ section.settings.link_label }}</span>
      </a>
    {%- endif -%}
  </div>
</div>

{%- style -%}
  .egnl {
    padding: {{ section.settings.pad_top }}rem var(--eg-gutter, clamp(1.5rem, 5vw, 5rem)) {{ section.settings.pad_bottom }}rem;
    text-align: center;
  }

  .egnl__inner {
    max-width: 58ch;
    margin: 0 auto;
  }

  .egnl__quote {
    margin: 0 0 1.5rem;
    font-family: var(--eg-serif, 'Cormorant Garamond', serif);
    font-weight: 300;
    font-style: italic;
    font-size: clamp(1.35rem, 2.2vw, 2rem);
    line-height: 1.55;
    letter-spacing: 0.01em;
  }

  .egnl__attribution {
    margin: 0 0 clamp(2.5rem, 5vw, 4rem);
    font-family: var(--eg-sans, Inter, sans-serif);
    font-size: 0.68rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    opacity: 0.5;
  }

  .egnl__form-wrap { display: flex; justify-content: center; }

  .egnl__form {
    display: flex;
    align-items: flex-end;
    gap: 1.5rem;
    width: 100%;
    max-width: 420px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .egnl__input {
    flex: 1 1 220px;
    background: transparent;
    border: 0;
    border-bottom: 1px solid currentColor;
    border-radius: 0;
    padding: 0.6rem 0;
    box-shadow: none;
    color: inherit;
    font-family: var(--eg-sans, Inter, sans-serif);
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    opacity: 0.85;
    transition: opacity 0.35s var(--eg-ease, ease);
  }
  .egnl__input::placeholder {
    color: currentColor;
    opacity: 0.45;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-size: 0.7rem;
  }
  .egnl__input:focus {
    outline: none;
    opacity: 1;
  }

  .egnl__submit {
    flex: 0 0 auto;
    background: none;
    border: 0;
    border-bottom: 1px solid currentColor;
    border-radius: 0;
    padding: 0.6rem 0;
    cursor: pointer;
    color: inherit;
    font-family: var(--eg-sans, Inter, sans-serif);
    font-size: 0.7rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    transition: opacity 0.35s var(--eg-ease, ease);
  }
  .egnl__submit:hover { opacity: 0.5; }

  .egnl__msg {
    flex: 1 0 100%;
    margin: 1rem 0 0;
    font-family: var(--eg-sans, Inter, sans-serif);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    opacity: 0.7;
  }
  .egnl__msg--error { opacity: 1; }

  .egnl__link {
    display: inline-block;
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    font-family: var(--eg-sans, Inter, sans-serif);
    font-size: 0.7rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: inherit;
    text-decoration: none;
  }
  .egnl__link span {
    display: inline-block;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid currentColor;
    transition: opacity 0.4s var(--eg-ease, cubic-bezier(0.22,1,0.36,1));
  }
  .egnl__link:hover span { opacity: 0.5; }

  @media screen and (max-width: 749px) {
    .egnl__form { gap: 1.75rem; }
  }
{%- endstyle -%}

{% schema %}
{
  "name": "EG Newsletter",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "paragraph", "content": "Quote-led signup for the bottom of the home page. Signups are tagged 'newsletter' in Customers." },
    { "type": "textarea", "id": "quote", "label": "Quote", "default": "True luxury is discovering something extraordinary — and knowing there will never be another quite like it." },
    { "type": "text", "id": "attribution", "label": "Attribution", "default": "Eugenia Grace" },
    { "type": "header", "content": "Signup" },
    { "type": "checkbox", "id": "show_form", "label": "Show signup form", "default": true },
    { "type": "text", "id": "placeholder", "label": "Field placeholder", "default": "Email address" },
    { "type": "text", "id": "button_label", "label": "Button text", "default": "Join" },
    { "type": "text", "id": "success_message", "label": "Success message", "default": "Thank you. We'll be in touch." },
    { "type": "header", "content": "Secondary link" },
    { "type": "text", "id": "link_label", "label": "Link text", "default": "Read the Journal" },
    { "type": "url", "id": "link_url", "label": "Link" },
    { "type": "header", "content": "Appearance" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#FFFFFF" },
    { "type": "color", "id": "text_color", "label": "Text colour", "default": "#1A1A1A" },
    { "type": "range", "id": "pad_top", "min": 3, "max": 16, "step": 1, "unit": "rem", "label": "Space above", "default": 9 },
    { "type": "range", "id": "pad_bottom", "min": 3, "max": 16, "step": 1, "unit": "rem", "label": "Space below", "default": 9 }
  ],
  "presets": [ { "name": "EG Newsletter" } ]
}
{% endschema %}