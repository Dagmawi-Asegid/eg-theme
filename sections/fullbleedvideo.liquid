<section class="eg-bleed" style="--bleed-h: {{ section.settings.height }}vh;">
  <div class="eg-bleed__media">
    {%- if section.settings.video != null -%}
      {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, preload: 'metadata' }}
    {%- elsif section.settings.poster != blank -%}
      {{ section.settings.poster | image_url: width: 2400 | image_tag: loading: 'eager', sizes: '100vw', widths: '800, 1200, 1600, 2000, 2400', alt: '' }}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
  </div>
  {%- if section.settings.heading != blank or section.settings.cta_label != blank -%}
    <div class="eg-bleed__content eg-bleed__content--{{ section.settings.text_tone }}">
      {%- if section.settings.heading != blank -%}
        <h2 class="eg-bleed__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="eg-bleed__sub">{{ section.settings.subheading }}</p>
      {%- endif -%}
      {%- if section.settings.cta_label != blank -%}
        <a class="eg-bleed__cta" href="{{ section.settings.cta_url | default: '#' }}">{{ section.settings.cta_label }}</a>
      {%- endif -%}
    </div>
  {%- endif -%}
</section>

{%- style -%}
  .eg-bleed { position: relative; height: var(--bleed-h); min-height: 420px; overflow: hidden; }
  .eg-bleed__media, .eg-bleed__media video, .eg-bleed__media img, .eg-bleed__media svg {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block;
  }
  .eg-bleed__content {
    position: absolute;
    left: clamp(1.5rem, 4vw, 4rem);
    bottom: clamp(1.5rem, 4vw, 3.5rem);
    max-width: 46ch;
    z-index: 2;
  }
  .eg-bleed__content--light { color: #FFFFFF; text-shadow: 0 1px 14px rgba(0,0,0,0.35); }
  .eg-bleed__content--dark { color: #1A1A1A; }
  .eg-bleed__heading {
    font-family: var(--eg-serif);
    font-size: var(--eg-h1);
    font-weight: 400;
    line-height: 1.05;
    margin: 0 0 0.6rem;
    color: inherit;
  }
  .eg-bleed__sub {
    font-family: var(--eg-sans);
    font-size: var(--eg-body);
    line-height: 1.55;
    margin: 0 0 1.4rem;
    color: inherit;
  }
  .eg-bleed__cta {
    font-family: var(--eg-sans);
    font-size: 0.8rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    padding-bottom: 0.3rem;
  }
  .eg-bleed__cta:hover { opacity: 0.75; }
  @media screen and (max-width: 749px) {
    .eg-bleed { min-height: 70vh; }
  }
{%- endstyle -%}

{% schema %}
{
  "name": "Full-Bleed Video",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "video", "id": "video", "label": "Video (autoplays muted, loops)" },
    { "type": "image_picker", "id": "poster", "label": "Fallback image (shows if no video)" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "text", "id": "cta_label", "label": "Link label" },
    { "type": "url", "id": "cta_url", "label": "Link" },
    {
      "type": "select",
      "id": "text_tone",
      "label": "Text color",
      "options": [
        { "value": "light", "label": "Light (for dark footage)" },
        { "value": "dark", "label": "Dark (for light footage)" }
      ],
      "default": "light"
    },
    { "type": "range", "id": "height", "label": "Section height", "min": 60, "max": 100, "step": 5, "unit": "vh", "default": 100 }
  ],
  "presets": [ { "name": "Full-Bleed Video" } ]
}
{% endschema %}