{%- comment -%}
  EG Nav Drawer — eg-nav-drawer.liquid
  Two-panel navigation drawer. Left: top-level menu items.
  Right: that item's children, with collection images pulled in
  automatically. Requires a nested menu (Content > Menus).
{%- endcomment -%}

{%- assign menu = section.settings.menu -%}

<div class="egnav" data-egnav>
  <button type="button" class="egnav__trigger" data-egnav-open aria-label="Open menu">
    <span class="egnav__burger" aria-hidden="true"></span>
    {%- if section.settings.trigger_label != blank -%}
      <span class="egnav__trigger-label">{{ section.settings.trigger_label }}</span>
    {%- endif -%}
  </button>

  <div class="egnav__scrim" data-egnav-close hidden></div>

  <aside class="egnav__panel" role="dialog" aria-modal="true" aria-label="Navigation">
    <header class="egnav__head">
      <button type="button" class="egnav__close" data-egnav-close>
        <span class="egnav__x" aria-hidden="true"></span>
        <span>{{ section.settings.close_label }}</span>
      </button>
    </header>

    <div class="egnav__body" data-egnav-body>
      <nav class="egnav__list" aria-label="Categories">
        {%- for link in menu.links -%}
          <button type="button"
                  class="egnav__tab{% if forloop.first %} is-active{% endif %}"
                  data-egnav-tab="{{ forloop.index }}">
            <span>{{ link.title }}</span>
            {%- if link.links.size > 0 -%}
              <span class="egnav__chev" aria-hidden="true"></span>
            {%- endif -%}
          </button>
        {%- endfor -%}
      </nav>

      <div class="egnav__panes">
        {%- for link in menu.links -%}
          <div class="egnav__pane{% if forloop.first %} is-active{% endif %}" data-egnav-pane="{{ forloop.index }}">
            <button type="button" class="egnav__back" data-egnav-back>
              <span class="egnav__back-arrow" aria-hidden="true"></span>
              <span>{{ section.settings.back_label }}</span>
            </button>

            <a class="egnav__all" href="{{ link.url }}">{{ section.settings.all_prefix }} {{ link.title }}</a>

            {%- if link.links.size > 0 -%}
              <ul class="egnav__subs{% unless section.settings.show_images %} egnav__subs--text{% endunless %}" role="list">
                {%- for child in link.links -%}
                  {%- assign obj = child.object -%}
                  <li class="egnav__sub">
                    <a href="{{ child.url }}">
                      {%- if section.settings.show_images -%}
                        <span class="egnav__thumb">
                          {%- if obj.image != blank -%}
                            {{ obj.image | image_url: width: 500 | image_tag: loading: 'lazy', alt: child.title }}
                          {%- elsif obj.featured_image != blank -%}
                            {{ obj.featured_image | image_url: width: 500 | image_tag: loading: 'lazy', alt: child.title }}
                          {%- endif -%}
                        </span>
                      {%- endif -%}
                      <span class="egnav__sub-label">{{ child.title }}</span>
                    </a>
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  </aside>
</div>

{%- style -%}
  .egnav { display: inline-block; }

  .egnav__trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    color: var(--eg-ink, #1a1a1a);
    transition: opacity 0.4s var(--eg-ease, cubic-bezier(0.22,1,0.36,1));
  }
  .egnav__trigger:hover { opacity: 0.5; }

  .egnav__burger {
    width: 22px;
    height: 10px;
    flex: 0 0 22px;
    background:
      linear-gradient(currentColor, currentColor) top left / 100% 1px no-repeat,
      linear-gradient(currentColor, currentColor) bottom left / 100% 1px no-repeat;
  }
  .egnav__trigger-label {
    font-family: var(--eg-sans, Inter, sans-serif);
    font-size: 0.7rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .egnav__scrim {
    position: fixed;
    inset: 0;
    background: rgba(26, 26, 26, 0.28);
    opacity: 0;
    transition: opacity 0.6s var(--eg-ease, cubic-bezier(0.22,1,0.36,1));
    z-index: 200;
  }
  .egnav__scrim.is-open { opacity: 1; }

  .egnav__panel {
    position: fixed;
    top: 0;
    {{ section.settings.side }}: 0;
    height: 100dvh;
    width: min({{ section.settings.width }}px, 100vw);
    background: #fff;
    display: flex;
    flex-direction: column;
    transform: translateX({% if section.settings.side == 'right' %}100%{% else %}-100%{% endif %});
    transition: transform 0.7s var(--eg-ease, cubic-bezier(0.22,1,0.36,1));
    z-index: 201;
  }
  .egnav__panel.is-open { transform: translateX(0); }

  .egnav__head {
    flex: 0 0 auto;
    padding: 2.5rem clamp(1.75rem, 3vw, 3.5rem) 1.5rem;
  }
  .egnav__close {
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    color: var(--eg-ink, #1a1a1a);
    font-family: var(--eg-sans, Inter, sans-serif);
    font-size: 0.7rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    transition: opacity 0.4s var(--eg-ease, ease);
  }
  .egnav__close:hover { opacity: 0.5; }
  .egnav__x {
    position: relative;
    width: 15px;
    height: 15px;
    flex: 0 0 15px;
  }
  .egnav__x::before,
  .egnav__x::after {
    content: '';
    position: absolute;
    top: 50%; left: 0;
    width: 100%; height: 1px;
    background: currentColor;
  }
  .egnav__x::before { transform: rotate(45deg); }
  .egnav__x::after  { transform: rotate(-45deg); }

  .egnav__body {
    flex: 1 1 auto;
    display: flex;
    min-height: 0;
    transition: transform 0.5s var(--eg-ease, cubic-bezier(0.22,1,0.36,1));
  }

  .egnav__list {
    flex: 0 0 38%;
    display: flex;
    flex-direction: column;
    padding: 1rem clamp(1.75rem, 3vw, 3.5rem) 3rem;
    overflow-y: auto;
  }

  .egnav__tab {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    width: 100%;
    padding: 0.95rem 0;
    background: none;
    border: 0;
    cursor: pointer;
    text-align: left;
    font-family: var(--eg-sans, Inter, sans-serif);
    font-size: 0.92rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--eg-ink, #1a1a1a);
    opacity: 0.45;
    transition: opacity 0.35s var(--eg-ease, ease);
  }
  .egnav__tab:hover { opacity: 0.75; }
  .egnav__tab.is-active { opacity: 1; }

  .egnav__chev {
    width: 7px; height: 7px;
    flex: 0 0 7px;
    border-top: 1px solid currentColor;
    border-right: 1px solid currentColor;
    transform: rotate(45deg);
  }

  .egnav__panes {
    flex: 1 1 auto;
    min-width: 0;
    border-left: 1px solid var(--eg-hairline, rgba(26, 26, 26, 0.14));
    padding: 1rem clamp(1.75rem, 3vw, 3.5rem) 3rem;
    overflow-y: auto;
  }

  .egnav__pane { display: none; }
  .egnav__pane.is-active { display: block; }

  .egnav__back { display: none; }

  .egnav__all {
    display: inline-block;
    margin-bottom: 2.25rem;
    font-family: var(--eg-sans, Inter, sans-serif);
    font-size: 0.7rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--eg-ink, #1a1a1a);
    text-decoration: none;
    opacity: 0.5;
    transition: opacity 0.35s var(--eg-ease, ease);
  }
  .egnav__all:hover { opacity: 1; }

  .egnav__subs {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.5rem, 2.5vw, 2.5rem);
  }
  .egnav__subs--text { grid-template-columns: repeat(2, 1fr); }

  .egnav__sub a {
    display: block;
    text-decoration: none;
    color: var(--eg-ink, #1a1a1a);
  }

  .egnav__thumb {
    display: block;
    aspect-ratio: 1 / 1;
    background: #f5f5f5;
    overflow: hidden;
    margin-bottom: 0.9rem;
  }
  .egnav__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 1.2s var(--eg-ease, cubic-bezier(0.22,1,0.36,1));
  }
  .egnav__sub a:hover .egnav__thumb img { transform: scale(1.05); }

  .egnav__sub-label {
    display: block;
    font-family: var(--eg-serif, 'Cormorant Garamond', serif);
    font-weight: 300;
    font-size: 1.15rem;
    line-height: 1.3;
    transition: opacity 0.35s var(--eg-ease, ease);
  }
  .egnav__subs--text .egnav__sub-label {
    font-family: var(--eg-sans, Inter, sans-serif);
    font-size: 0.88rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.5rem 0;
  }
  .egnav__sub a:hover .egnav__sub-label { opacity: 0.5; }

  /* Mobile: drill-down instead of two panels */
  @media screen and (max-width: 900px) {
    .egnav__panel { width: 100vw; }
    .egnav__body { width: 200%; }
    .egnav__body.is-drilled { transform: translateX(-50%); }
    .egnav__list,
    .egnav__panes { flex: 0 0 50%; }
    .egnav__panes { border-left: 0; }
    .egnav__subs { grid-template-columns: repeat(2, 1fr); }

    .egnav__back {
      display: inline-flex;
      align-items: center;
      gap: 0.75rem;
      background: none;
      border: 0;
      padding: 0 0 1.75rem;
      cursor: pointer;
      color: var(--eg-ink, #1a1a1a);
      font-family: var(--eg-sans, Inter, sans-serif);
      font-size: 0.7rem;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      opacity: 0.6;
    }
    .egnav__back-arrow {
      width: 7px; height: 7px;
      border-top: 1px solid currentColor;
      border-left: 1px solid currentColor;
      transform: rotate(-45deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .egnav__panel, .egnav__scrim, .egnav__body { transition: none; }
  }
{%- endstyle -%}

<script>
  (function () {
    var root = document.querySelector('[data-egnav]');
    if (!root || root.dataset.egnavBound === 'true') return;
    root.dataset.egnavBound = 'true';

    var panel   = root.querySelector('.egnav__panel');
    var scrim   = root.querySelector('.egnav__scrim');
    var trigger = root.querySelector('[data-egnav-open]');
    var body    = root.querySelector('[data-egnav-body]');
    var tabs    = root.querySelectorAll('[data-egnav-tab]');
    var panes   = root.querySelectorAll('[data-egnav-pane]');
    var isMobile = function () { return window.matchMedia('(max-width: 900px)').matches; };

    function activate(index) {
      tabs.forEach(function (t) {
        t.classList.toggle('is-active', t.getAttribute('data-egnav-tab') === index);
      });
      panes.forEach(function (p) {
        p.classList.toggle('is-active', p.getAttribute('data-egnav-pane') === index);
      });
    }

    function open() {
      scrim.hidden = false;
      requestAnimationFrame(function () {
        scrim.classList.add('is-open');
        panel.classList.add('is-open');
      });
      document.body.style.overflow = 'hidden';
    }

    function close() {
      scrim.classList.remove('is-open');
      panel.classList.remove('is-open');
      body.classList.remove('is-drilled');
      document.body.style.overflow = '';
      setTimeout(function () { scrim.hidden = true; }, 700);
    }

    trigger.addEventListener('click', open);
    root.querySelectorAll('[data-egnav-close]').forEach(function (el) {
      el.addEventListener('click', close);
    });
    root.querySelectorAll('[data-egnav-back]').forEach(function (el) {
      el.addEventListener('click', function () { body.classList.remove('is-drilled'); });
    });

    tabs.forEach(function (tab) {
      var index = tab.getAttribute('data-egnav-tab');
      tab.addEventListener('click', function () {
        activate(index);
        if (isMobile()) body.classList.add('is-drilled');
      });
      tab.addEventListener('mouseenter', function () {
        if (!isMobile()) activate(index);
      });
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && panel.classList.contains('is-open')) close();
    });
  })();
</script>

{% schema %}
{
  "name": "EG Nav Drawer",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "paragraph", "content": "Requires a nested menu. In Content > Menus, add subcategory items indented under each top-level category. Subcategory images are pulled from the linked collection's image automatically." },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" },
    { "type": "select", "id": "side", "label": "Opens from", "options": [
      { "value": "left", "label": "Left" },
      { "value": "right", "label": "Right" }
    ], "default": "left" },
    { "type": "range", "id": "width", "min": 600, "max": 1200, "step": 20, "unit": "px", "label": "Drawer width", "default": 940 },
    { "type": "checkbox", "id": "show_images", "label": "Show subcategory images", "default": true },
    { "type": "header", "content": "Labels" },
    { "type": "text", "id": "trigger_label", "label": "Trigger label (leave blank for icon only)" },
    { "type": "text", "id": "close_label", "label": "Close label", "default": "Close" },
    { "type": "text", "id": "all_prefix", "label": "Prefix for the 'all' link", "default": "All" },
    { "type": "text", "id": "back_label", "label": "Mobile back label", "default": "Back" }
  ],
  "presets": [ { "name": "EG Nav Drawer" } ]
}
{% endschema %}