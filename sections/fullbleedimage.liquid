<section class="eg-bleedi" style="--bleedi-h: {{ section.settings.height }}vh;">
  <div class="eg-bleedi__media">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 2400 | image_tag: loading: 'lazy', sizes: '100vw', widths: '800, 1200, 1600, 2000, 2400', alt: section.settings.heading }}
    {%- else -%}
      {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
  </div>
  {%- if section.settings.heading != blank or section.settings.cta_label != blank -%}
    <div class="eg-bleedi__content eg-bleedi__content--{{ section.settings.text_tone }}">
      {%- if section.settings.heading != blank -%}
        <h2 class="eg-bleedi__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="eg-bleedi__sub">{{ section.settings.subheading }}</p>
      {%- endif -%}
      {%- if section.settings.cta_label != blank -%}
        <a class="eg-bleedi__cta" href="{{ section.settings.cta_url | default: '#' }}">{{ section.settings.cta_label }}</a>
      {%- endif -%}
    </div>
  {%- endif -%}
</section>

{%- style -%}
  .eg-bleedi { position: relative; height: var(--bleedi-h); min-height: 420px; overflow: hidden; }
  .eg-bleedi__media, .eg-bleedi__media img, .eg-bleedi__media svg {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block;
  }
  .eg-bleedi__content {
    position: absolute;
    left: clamp(1.5rem, 4vw, 4rem);
    bottom: clamp(1.5rem, 4vw, 3.5rem);
    max-width: 46ch;
    z-index: 2;
  }
  .eg-bleedi__content--light { color: #FFFFFF; text-shadow: 0 1px 14px rgba(0,0,0,0.35); }
  .eg-bleedi__content--dark { color: #1A1A1A; }
  .eg-bleedi__heading {
    font-family: var(--eg-serif);
    font-size: var(--eg-h1);
    font-weight: 400;
    line-height: 1.05;
    margin: 0 0 0.6rem;
    color: inherit;
  }
  .eg-bleedi__sub {
    font-family: var(--eg-sans);
    font-size: var(--eg-body);
    line-height: 1.55;
    margin: 0 0 1.4rem;
    color: inherit;
  }
  .eg-bleedi__cta {
    font-family: var(--eg-sans);
    font-size: 0.8rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    padding-bottom: 0.3rem;
  }
  .eg-bleedi__cta:hover { opacity: 0.75; }
  @media screen and (max-width: 749px) {
    .eg-bleedi { min-height: 60vh; }
  }
{%- endstyle -%}

{% schema %}
{
  "name": "Full-Bleed Image",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "text", "id": "cta_label", "label": "Link label" },
    { "type": "url", "id": "cta_url", "label": "Link" },
    {
      "type": "select",
      "id": "text_tone",
      "label": "Text color",
      "options": [
        { "value": "light", "label": "Light (for dark imagery)" },
        { "value": "dark", "label": "Dark (for light imagery)" }
      ],
      "default": "light"
    },
    { "type": "range", "id": "height", "label": "Section height", "min": 50, "max": 100, "step": 5, "unit": "vh", "default": 90 }
  ],
  "presets": [ { "name": "Full-Bleed Image" } ]
}
{% endschema %}