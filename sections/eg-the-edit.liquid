{%- comment -%}
  EG The Edit — eg-the-edit.liquid
  Simon layout, section 05.
  Centered headline, full-width collection banner with overlay text,
  then a row of product cards. Each card pulls its images from the
  product and shows dots to move between them.
{%- endcomment -%}

<div class="egte eg-reveal egte--dots-{{ section.settings.dot_position }}" style="background: {{ section.settings.bg }};" data-egte>
  {%- if section.settings.heading != blank -%}
    <h2 class="egte__heading">{{ section.settings.heading }}</h2>
  {%- endif -%}

  {%- if section.settings.image != blank -%}
    <a class="egte__banner"{% if section.settings.banner_link != blank %} href="{{ section.settings.banner_link }}"{% endif %}>
      {{ section.settings.image | image_url: width: 3000 | image_tag:
         loading: 'lazy', sizes: '100vw',
         widths: '750, 1100, 1500, 2000, 3000',
         class: 'egte__banner-img', alt: section.settings.banner_title }}
      <div class="egte__banner-text">
        {%- if section.settings.banner_title != blank -%}
          <p class="egte__banner-title">{{ section.settings.banner_title }}</p>
        {%- endif -%}
        {%- if section.settings.banner_link_label != blank -%}
          <p class="egte__banner-cta">{{ section.settings.banner_link_label }}</p>
        {%- endif -%}
      </div>
    </a>
  {%- endif -%}

  <ul class="egte__row" role="list">
    {%- for block in section.blocks -%}
      {%- assign p = block.settings.product -%}
      <li class="egte__card" {{ block.shopify_attributes }} data-egte-card>
        {%- if p != blank -%}
          {%- assign img_count = p.images.size -%}
          {%- if img_count > section.settings.max_images -%}
            {%- assign img_count = section.settings.max_images -%}
          {%- endif -%}

          <div class="egte__frame">
            <a class="egte__link" href="{{ p.url }}" tabindex="-1" aria-hidden="true" data-egte-media>
              <div class="egte__media">
                {%- if p.images.size > 0 -%}
                  {%- for img in p.images limit: section.settings.max_images -%}
                    <div class="egte__slide{% if forloop.first %} is-active{% endif %}" data-egte-slide>
                      {{ img | image_url: width: 1200 | image_tag:
                         loading: 'lazy',
                         sizes: '(min-width: 750px) 30vw, 90vw',
                         widths: '400, 700, 1000, 1200',
                         class: 'egte__img',
                         alt: img.alt | default: p.title }}
                    </div>
                  {%- endfor -%}
                {%- else -%}
                  <div class="egte__slide is-active">
                    {{ 'product-1' | placeholder_svg_tag: 'egte__img' }}
                  </div>
                {%- endif -%}
              </div>
            </a>

            {%- if img_count > 1 -%}
              <div class="egte__dots" role="group" aria-label="{{ p.title | escape }} images">
                {%- for i in (1..img_count) -%}
                  <button
                    type="button"
                    class="egte__dot{% if forloop.first %} is-active{% endif %}"
                    data-egte-dot="{{ forloop.index0 }}"
                    aria-label="Show image {{ i }} of {{ img_count }}"
                    {% if forloop.first %}aria-current="true"{% endif %}
                  ></button>
                {%- endfor -%}
              </div>
            {%- endif -%}
          </div>

          <a class="egte__link" href="{{ p.url }}">
            <div class="egte__info">
              <h3 class="egte__title">{{ p.title }}</h3>
              {%- if block.settings.caption != blank -%}
                <p class="egte__caption">{{ block.settings.caption }}</p>
              {%- endif -%}
              {%- if section.settings.show_price -%}
                <p class="egte__price">{{ p.price | money }}</p>
              {%- endif -%}
            </div>
          </a>
        {%- else -%}
          <div class="egte__frame">
            <div class="egte__media">
              <div class="egte__slide is-active">{{ 'product-1' | placeholder_svg_tag: 'egte__img' }}</div>
            </div>
          </div>
          <div class="egte__info"><h3 class="egte__title">Select a product</h3></div>
        {%- endif -%}
      </li>
    {%- endfor -%}
  </ul>
</div>

{%- style -%}
  .egte { padding: {{ section.settings.pad_top }}rem 0 {{ section.settings.pad_bottom }}rem; }

  .egte__heading {
    margin: 0 0 clamp(2.5rem, 5vw, 4.5rem);
    text-align: center;
    font-family: var(--eg-serif, 'Cormorant Garamond', serif);
    font-weight: 300;
    font-size: clamp(1.9rem, 3vw, 3rem);
    letter-spacing: 0.01em;
    color: var(--eg-ink, #1a1a1a);
  }

  .egte__banner {
    display: block;
    position: relative;
    overflow: hidden;
    text-decoration: none;
    aspect-ratio: {{ section.settings.banner_ratio }};
  }
  .egte__banner-img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .egte__banner-text {
    position: absolute;
    left: 50%;
    bottom: clamp(2rem, 5vw, 4rem);
    transform: translateX(-50%);
    text-align: center;
    color: #fff;
  }
  .egte__banner-title {
    margin: 0 0 0.6rem;
    font-family: var(--eg-serif, 'Cormorant Garamond', serif);
    font-weight: 300;
    font-size: clamp(1.5rem, 2.4vw, 2.4rem);
    line-height: 1.2;
  }
  .egte__banner-cta {
    margin: 0;
    font-family: var(--eg-sans, Inter, sans-serif);
    font-size: 0.68rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    opacity: 0.9;
  }

  .egte__row {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat({{ section.blocks.size }}, 1fr);
  }

  .egte__card {
    border-right: 1px solid var(--eg-hairline, rgba(26,26,26,0.14));
    padding-bottom: 2.5rem;
  }
  .egte__card:last-child { border-right: 0; }

  .egte__link { display: block; text-decoration: none; color: inherit; }

  .egte__frame { position: relative; }

  .egte__media {
    position: relative;
    aspect-ratio: 1 / 1;
    background: #fff;
    overflow: hidden;
    touch-action: pan-y;
  }
  .egte__slide {
    position: absolute;
    inset: 0;
    padding: 12%;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.6s var(--eg-ease, cubic-bezier(0.22,1,0.36,1)), visibility 0s linear 0.6s;
  }
  .egte__slide.is-active {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.6s var(--eg-ease, cubic-bezier(0.22,1,0.36,1)), visibility 0s;
  }
  .egte__img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    display: block;
    transition: transform 1.4s var(--eg-ease, cubic-bezier(0.22,1,0.36,1));
  }
  .egte__card:hover .egte__slide.is-active .egte__img { transform: scale(1.04); }

  .egte__dots {
    display: flex;
    justify-content: center;
    gap: 0.25rem;
  }
  .egte--dots-below .egte__dots { padding: 0.9rem 0 1.1rem; }
  .egte--dots-over .egte__dots {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.9rem;
    z-index: 2;
  }
  .egte__dot {
    position: relative;
    width: 1.5rem;
    height: 1.5rem;
    padding: 0;
    margin: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
  }
  .egte__dot::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    transform: translate(-50%, -50%);
    border: 1px solid var(--eg-ink, #1a1a1a);
    background: transparent;
    opacity: 0.35;
    transition: opacity 0.3s ease, background-color 0.3s ease;
  }
  .egte__dot:hover::before { opacity: 0.7; }
  .egte__dot.is-active::before {
    background: var(--eg-ink, #1a1a1a);
    opacity: 1;
  }
  .egte__dot:focus-visible {
    outline: 1px solid var(--eg-ink, #1a1a1a);
    outline-offset: -2px;
  }

  .egte--dots-over .egte__info { padding-top: 1.4rem; }
  .egte__info { text-align: center; padding: 0 1.5rem; }

  .egte__title {
    margin: 0 0 0.45rem;
    font-family: var(--eg-serif, 'Cormorant Garamond', serif);
    font-weight: 300;
    font-size: clamp(1.05rem, 1.3vw, 1.3rem);
    line-height: 1.3;
    transition: opacity 0.4s var(--eg-ease, ease);
  }
  .egte__card:hover .egte__title { opacity: 0.55; }

  .egte__caption,
  .egte__price {
    margin: 0 0 0.25rem;
    font-family: var(--eg-sans, Inter, sans-serif);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    opacity: 0.6;
  }

  @media (prefers-reduced-motion: reduce) {
    .egte__slide, .egte__slide.is-active, .egte__img { transition: none; }
  }

  @media screen and (max-width: 749px) {
    .egte__row { grid-template-columns: 1fr; }
    .egte__card {
      border-right: 0;
      border-bottom: 1px solid var(--eg-hairline, rgba(26,26,26,0.14));
    }
    .egte__card:last-child { border-bottom: 0; }
  }
{%- endstyle -%}

<script>
  (function () {
    function initEdit(root) {
      if (!root || root.dataset.egteReady) return;
      root.dataset.egteReady = 'true';

      root.querySelectorAll('[data-egte-card]').forEach(function (card) {
        var slides = card.querySelectorAll('[data-egte-slide]');
        var dots = card.querySelectorAll('[data-egte-dot]');
        var media = card.querySelector('[data-egte-media]');
        if (slides.length < 2) return;

        var current = 0;
        var suppressClick = false;

        function go(index) {
          var total = slides.length;
          current = (index + total) % total;
          slides.forEach(function (s, i) { s.classList.toggle('is-active', i === current); });
          dots.forEach(function (d, i) {
            var on = i === current;
            d.classList.toggle('is-active', on);
            if (on) { d.setAttribute('aria-current', 'true'); } else { d.removeAttribute('aria-current'); }
          });
        }

        dots.forEach(function (dot) {
          dot.addEventListener('click', function (e) {
            e.preventDefault();
            e.stopPropagation();
            go(parseInt(dot.dataset.egteDot, 10));
          });
        });

        if (media) {
          var startX = 0, startY = 0;
          media.addEventListener('touchstart', function (e) {
            startX = e.touches[0].clientX;
            startY = e.touches[0].clientY;
          }, { passive: true });

          media.addEventListener('touchend', function (e) {
            var dx = e.changedTouches[0].clientX - startX;
            var dy = e.changedTouches[0].clientY - startY;
            if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy)) {
              suppressClick = true;
              go(dx < 0 ? current + 1 : current - 1);
              setTimeout(function () { suppressClick = false; }, 400);
            }
          }, { passive: true });

          media.addEventListener('click', function (e) {
            if (suppressClick) { e.preventDefault(); }
          });
        }
      });
    }

    document.querySelectorAll('[data-egte]').forEach(initEdit);

    document.addEventListener('shopify:section:load', function (e) {
      e.target.querySelectorAll('[data-egte]').forEach(initEdit);
    });
  })();
</script>

{% schema %}
{
  "name": "EG The Edit",
  "tag": "section",
  "class": "section",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Jewelry Edit" },
    { "type": "header", "content": "Banner" },
    { "type": "image_picker", "id": "image", "label": "Banner image" },
    { "type": "text", "id": "banner_title", "label": "Banner title", "default": "Collection Name" },
    { "type": "text", "id": "banner_link_label", "label": "Banner link text", "default": "Explore Jewelry Collection" },
    { "type": "url", "id": "banner_link", "label": "Banner link" },
    { "type": "select", "id": "banner_ratio", "label": "Banner shape", "options": [
      { "value": "21 / 9", "label": "Wide" },
      { "value": "16 / 9", "label": "Standard" },
      { "value": "2 / 1", "label": "Panoramic" }
    ], "default": "21 / 9" },
    { "type": "header", "content": "Products" },
    { "type": "checkbox", "id": "show_price", "label": "Show price", "default": true },
    { "type": "range", "id": "max_images", "min": 1, "max": 8, "step": 1, "label": "Images per product", "info": "How many of each product's images the dots cycle through. Set to 1 to hide dots.", "default": 4 },
    { "type": "select", "id": "dot_position", "label": "Dot position", "options": [
      { "value": "below", "label": "Below image" },
      { "value": "over", "label": "On image" }
    ], "default": "below" },
    { "type": "header", "content": "Spacing" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#FFFFFF" },
    { "type": "range", "id": "pad_top", "min": 2, "max": 16, "step": 1, "unit": "rem", "label": "Space above", "default": 8 },
    { "type": "range", "id": "pad_bottom", "min": 2, "max": 16, "step": 1, "unit": "rem", "label": "Space below", "default": 8 }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "text", "id": "caption", "label": "Caption line", "info": "Optional, e.g. material or medium" }
      ]
    }
  ],
  "presets": [
    {
      "name": "EG The Edit",
      "blocks": [ { "type": "product" }, { "type": "product" }, { "type": "product" } ]
    }
  ]
}
{% endschema %}