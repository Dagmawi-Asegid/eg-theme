{%- comment -%}
  EG Product Frame (v4) — sections/eg-product-frame.liquid
  Hermès-style product page, matched to Rose's Hermès references (Oct 23 + Oct 27)
  and Tahmid's task list (Oct 28).
  Desktop
  - 3+ photos: two photos side by side fill the frame. Clicking a later photo shifts
    the pair (click the 3rd -> 2nd + 3rd, the 1st slides out). The buy box is a card
    floating over the bottom-right of the right photo.
  - 2 photos: the photos take the left two thirds, the buy box the right third.
  - "← Back" pill top left, small thumbnails bottom left inside the frame
    (active one underlined).
  Buy box: title, colour boxes right under the title, price, Apple Pay + Add to cart.
  Zoom: click a photo -> full-screen view you scroll down through, × to close,
  a vertical + / − zoom slider on the left, thumbnails bottom left.
  Only used by templates/product.frame.json.
{%- endcomment -%}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign media_count = product.media.size
  assign layout = 'many'
  if media_count < 3
    assign layout = 'two'
  endif
  if media_count < 2
    assign layout = 'one'
  endif
  comment
    Artisan (from the product's Artisan entry) and the link to the artisan's page:
    the product's collection that uses the "artisan" template, or the collection
    whose handle matches the artisan entry (e.g. julia-pappas).
  endcomment
  assign ao = product.metafields.custom.artisan.value
  assign a_name = blank
  assign a_url = blank
  if ao != blank
    assign a_name = ao.name.value | default: ao.name
  endif
  for c in product.collections
    if c.template_suffix == 'artisan'
      assign a_url = c.url
      break
    endif
  endfor
  if a_url == blank and ao != blank and ao.system.handle != blank
    assign a_coll = collections[ao.system.handle]
    if a_coll.id != blank
      assign a_url = a_coll.url
    endif
  endif
  assign back_url = routes.all_products_collection_url
  if product.collections.size > 0
    assign back_url = product.collections.first.url
  endif
-%}

<section class="egpf egpf--{{ layout }}" id="egpf-{{ section.id }}" data-count="{{ media_count }}"
  style="--egpf-h: {{ section.settings.frame_height }}vh; --egpf-bg: {{ section.settings.frame_bg }};">
  <div class="egpf__frame">
    <a class="egpf__back" href="{{ back_url }}" data-egpf-back>&larr;&nbsp;Back</a>

    <div class="egpf__stage" data-egpf-stage>
      <div class="egpf__track" data-egpf-track>
        {%- for media in product.media -%}
          {%- liquid
            assign img_alt = media.alt
            if img_alt == blank
              assign img_alt = product.title
            endif
            if forloop.index0 < 2
              assign img_loading = 'eager'
            else
              assign img_loading = 'lazy'
            endif
          -%}
          <button type="button" class="egpf__slot" data-egpf-slot="{{ forloop.index0 }}" data-media-id="{{ media.id }}"
            aria-label="Zoom image {{ forloop.index }}">
            {{ media | image_url: width: 1800 | image_tag: loading: img_loading, sizes: '(min-width: 990px) 50vw, 100vw', widths: '600, 900, 1200, 1800', class: 'egpf__img', alt: img_alt }}
          </button>
        {%- else -%}
          <div class="egpf__slot">{{ 'product-1' | placeholder_svg_tag: 'egpf__img' }}</div>
        {%- endfor -%}
      </div>
    </div>

    {%- if media_count > 2 -%}
      <button type="button" class="egpf__arrow egpf__arrow--prev" data-egpf-prev aria-label="Previous image">&larr;</button>
      <button type="button" class="egpf__arrow egpf__arrow--next" data-egpf-next aria-label="Next image">&rarr;</button>
    {%- endif -%}

    {%- if media_count > 1 -%}
      <div class="egpf__thumbs">
        {%- for media in product.media -%}
          <button type="button" class="egpf__thumb{% if forloop.first %} is-active{% endif %}"
            data-egpf-thumb="{{ forloop.index0 }}" aria-label="Show image {{ forloop.index }}">
            {{ media | image_url: width: 120 | image_tag: loading: 'lazy', alt: '' }}
          </button>
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="egpf__buy">
      {%- if product.vendor != blank and section.settings.show_vendor -%}
        <p class="egpf__vendor">{{ product.vendor }}</p>
      {%- endif -%}
      <h1 class="egpf__title">{{ product.title }}</h1>
      {%- if a_name != blank -%}
        <p class="egpf__by">By {% if a_url != blank %}<a href="{{ a_url }}">{{ a_name }}</a>{% else %}{{ a_name }}{% endif %}</p>
      {%- endif -%}

      {%- form 'product', product, class: 'egpf__form' -%}
        <input type="hidden" name="id" value="{{ current_variant.id }}" data-egpf-id>

        {%- unless product.has_only_default_variant -%}
          {%- for option in product.options_with_values -%}
            <fieldset class="egpf__option">
              <legend class="egpf__label">
                <span>{{ option.name }}</span>
                <span class="egpf__chosen" data-egpf-chosen="{{ forloop.index0 }}">{{ option.selected_value }}</span>
              </legend>
              <div class="egpf__pills">
                {%- for value in option.values -%}
                  {%- assign sw_media = value.variant.featured_media -%}
                  <button type="button" class="egpf__pill{% if sw_media %} egpf__pill--swatch{% endif %}{% if value.selected %} is-active{% endif %}"
                    data-egpf-opt="{{ forloop.parentloop.index0 }}" data-value="{{ value.name | escape }}"
                    title="{{ value.name | escape }}" aria-label="{{ option.name | escape }}: {{ value.name | escape }}">
                    {%- if sw_media -%}
                      {{ sw_media | image_url: width: 160 | image_tag: loading: 'lazy', alt: value.name }}
                    {%- else -%}
                      {{ value.name }}
                    {%- endif -%}
                  </button>
                {%- endfor -%}
              </div>
            </fieldset>
          {%- endfor -%}
        {%- endunless -%}

        <p class="egpf__price" data-egpf-price>{{ current_variant.price | money }}</p>

        <div class="egpf__actions{% if section.settings.show_dynamic_checkout %} egpf__actions--two{% endif %}">
          {%- if section.settings.show_dynamic_checkout -%}
            <div class="egpf__pay">{{ form | payment_button }}</div>
          {%- endif -%}
          <button type="submit" name="add" class="egpf__add" data-egpf-add
            {% unless current_variant.available %}disabled{% endunless %}>
            <svg class="egpf__bag" width="13" height="13" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M3 5h10l-.8 9.2H3.8L3 5Zm2.5 0V3.8a2.5 2.5 0 0 1 5 0V5" fill="none" stroke="currentColor" stroke-width="1.2"/></svg>
            <span data-egpf-add-label>{%- if current_variant.available -%}Add to cart{%- else -%}Sold out{%- endif -%}</span>
          </button>
        </div>
      {%- endform -%}
    </div>
  </div>

  <div class="egpf__below">
    {%- if section.settings.show_description and product.description != blank -%}
      <div class="egpf__desc">{{ product.description }}</div>
    {%- endif -%}
    <div class="egpf__meta">
      {%- if current_variant.sku != blank -%}
        <p>Product reference: <span data-egpf-sku>{{ current_variant.sku }}</span></p>
      {%- endif -%}
      <p>Like to know more? <a href="{{ section.settings.contact_url | default: '/pages/contact' }}">Contact Customer Service</a></p>
    </div>
  </div>

  {%- liquid
    assign story_text = blank
    assign story_quote = blank
    if ao != blank
      assign story_text = ao.story.value | strip_html | strip
      assign story_quote = ao.quote.value
    endif
    comment
      Keep only the top paragraph (Rose: "we can work with the top paragraph").
    endcomment
    if story_text != blank and section.settings.story_first_paragraph
      assign story_parts = story_text | newline_to_br | split: '<br />'
      for part in story_parts
        assign part_clean = part | strip
        if part_clean != blank
          assign story_text = part_clean
          break
        endif
      endfor
    endif
  -%}
  {%- if section.settings.show_story and story_text != blank -%}
    <div class="egpf__story">
      <h2 class="egpf__story-title">{{ section.settings.story_heading }}</h2>
      {%- if a_name != blank -%}<p class="egpf__story-name">{{ a_name }}</p>{%- endif -%}
      <div class="egpf__story-text">{{ story_text }}</div>
      {%- if story_quote != blank -%}<p class="egpf__story-quote">&ldquo;{{ story_quote | strip_html }}&rdquo;</p>{%- endif -%}
      {%- if a_url != blank -%}
        <a class="egpf__story-link" href="{{ a_url }}">Discover {{ a_name | default: 'the artisan' }}&rsquo;s collection &rarr;</a>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- if product.collections.size > 0 -%}
    <nav class="egpf__crumbs" aria-label="Breadcrumb">
      <a href="{{ product.collections.first.url }}">{{ product.collections.first.title }}</a>
      <span aria-hidden="true">|</span>
      <span>{{ product.title }}</span>
    </nav>
  {%- endif -%}

  <div class="egpf__sticky" data-egpf-sticky aria-hidden="true">
    <div class="egpf__sticky-info">
      {%- if product.featured_media -%}
        {{ product.featured_media | image_url: width: 120 | image_tag: loading: 'lazy', alt: '', class: 'egpf__sticky-img' }}
      {%- endif -%}
      <div>
        <p class="egpf__sticky-title">{{ product.title }}</p>
        <p class="egpf__sticky-price" data-egpf-sticky-price>{{ current_variant.price | money }}</p>
      </div>
    </div>
    {%- assign sticky_form_id = 'egpf-sticky-form-' | append: section.id -%}
    {%- form 'product', product, class: 'egpf__sticky-form', id: sticky_form_id -%}
      <input type="hidden" name="id" value="{{ current_variant.id }}" data-egpf-sticky-id>
      <div class="egpf__actions{% if section.settings.show_dynamic_checkout %} egpf__actions--two{% endif %}">
        {%- if section.settings.show_dynamic_checkout -%}
          <div class="egpf__pay">{{ form | payment_button }}</div>
        {%- endif -%}
        <button type="submit" name="add" class="egpf__add egpf__sticky-add" data-egpf-sticky-add
          {% unless current_variant.available %}disabled{% endunless %}>
          <svg class="egpf__bag" width="13" height="13" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M3 5h10l-.8 9.2H3.8L3 5Zm2.5 0V3.8a2.5 2.5 0 0 1 5 0V5" fill="none" stroke="currentColor" stroke-width="1.2"/></svg>
          <span data-egpf-sticky-label>{%- if current_variant.available -%}Add to cart{%- else -%}Sold out{%- endif -%}</span>
        </button>
      </div>
    {%- endform -%}
  </div>

  {%- if media_count > 0 -%}
    <div class="egpf__zoom" data-egpf-zoom hidden role="dialog" aria-modal="true" aria-label="{{ product.title | escape }} images">
      <button type="button" class="egpf__close" data-egpf-zoom-close aria-label="Close">&times;</button>

      <div class="egpf__zoomctl" data-egpf-zoomctl>
        <button type="button" class="egpf__zoombtn" data-egpf-zoom-in aria-label="Zoom in">+</button>
        <input type="range" class="egpf__zoomrange" data-egpf-zoom-range min="1" max="3" step="0.05" value="1" aria-label="Zoom level" orient="vertical">
        <button type="button" class="egpf__zoombtn" data-egpf-zoom-out aria-label="Zoom out">&minus;</button>
      </div>

      <div class="egpf__zoom-list" data-egpf-zoom-list>
        {%- for media in product.media -%}
          <div class="egpf__zoom-item" data-egpf-zoom-item="{{ forloop.index0 }}">
            {{ media | image_url: width: 2400 | image_tag: loading: 'lazy', sizes: '100vw', widths: '1200, 1800, 2400', alt: media.alt }}
          </div>
        {%- endfor -%}
      </div>

      {%- if media_count > 1 -%}
        <div class="egpf__zoom-thumbs">
          {%- for media in product.media -%}
            <button type="button" class="egpf__thumb{% if forloop.first %} is-active{% endif %}" data-egpf-zoom-thumb="{{ forloop.index0 }}" aria-label="Show image {{ forloop.index }}">
              {{ media | image_url: width: 120 | image_tag: loading: 'lazy', alt: '' }}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  {%- endif -%}

  <script type="application/json" data-egpf-variants>
    {{ product.variants | json }}
  </script>
</section>

{%- style -%}
  #egpf-{{ section.id }} { padding: 0 0 0; background: var(--egpf-bg, #F8F5F0); }
  .egpf__frame {
    position: relative;
    height: min(var(--egpf-h, 100vh), calc(100vh - var(--egpf-header, 120px) - var(--egpf-pbar, 0px)));
    min-height: 420px;
    background: var(--egpf-bg, #F8F6F6);
    overflow: hidden;
  }

  .egpf__back {
    position: absolute; top: 1.25rem; left: 1.25rem; z-index: 6;
    display: inline-flex; align-items: center; gap: .35rem;
    padding: .45rem .9rem; border: 1px solid rgba(26,26,26,.12); border-radius: 999px;
    background: rgba(255,255,255,.92);
    font: inherit; font-size: .68rem; letter-spacing: .18em; text-transform: uppercase;
    color: #1a1a1a; text-decoration: none; cursor: pointer;
  }
  .egpf__back:hover { background: #fff; }

  /* Photos */
  .egpf__stage { position: absolute; inset: 0; overflow: hidden; }
  .egpf--two .egpf__stage, .egpf--one .egpf__stage { right: 33.3333%; }
  .egpf__track { display: flex; height: 100%; transition: transform .6s cubic-bezier(.22,.61,.36,1); will-change: transform; }
  .egpf__slot { flex: 0 0 50%; height: 100%; padding: 0; border: 0; background: transparent; cursor: zoom-in; overflow: hidden; }
  .egpf--many .egpf__slot { flex-basis: 33.3333%; }
  .egpf__slot + .egpf__slot { border-left: 1px solid var(--egpf-bg, #F8F5F0); }
  .egpf--one .egpf__slot { flex-basis: 100%; }
  .egpf__img { width: 100%; height: 100%; object-fit: cover; display: block; }

  .egpf__arrow {
    position: absolute; top: 50%; z-index: 5; transform: translateY(-50%);
    width: 2.6rem; height: 2.6rem; border: 0; border-radius: 50%;
    background: rgba(255,255,255,.9); color: #1a1a1a; font-size: 1rem; cursor: pointer;
    opacity: 0; transition: opacity .25s ease;
  }
  .egpf__frame:hover .egpf__arrow { opacity: 1; }
  .egpf__arrow[disabled] { opacity: 0 !important; pointer-events: none; }
  .egpf__arrow--prev { left: 1.25rem; }
  .egpf__arrow--next { right: 1.25rem; }
  /* 3-across: keep the next arrow on the middle photo, clear of the buy card */
  @media (min-width: 750px) { .egpf--many .egpf__arrow--next { right: auto; left: calc(66.6667% - 3.85rem); } }

  /* Small thumbnails, bottom left, active one underlined (Hermès) */
  .egpf__thumbs {
    position: absolute; left: 1.25rem; bottom: 1.1rem; z-index: 5;
    display: flex; gap: .35rem; max-width: calc(50% - 2.5rem); overflow-x: auto; scrollbar-width: none;
    padding-bottom: 5px;
  }
  .egpf__thumbs::-webkit-scrollbar { display: none; }
  .egpf__thumb {
    position: relative; flex: 0 0 38px; width: 38px; height: 38px; padding: 0; border: 0;
    background: transparent; cursor: pointer; opacity: .75;
  }
  .egpf__thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .egpf__thumb::after {
    content: ''; position: absolute; left: 0; right: 0; bottom: -5px; height: 2px;
    background: #1a1a1a; transform: scaleX(0); transition: transform .25s ease;
  }
  .egpf__thumb.is-active, .egpf__thumb:hover { opacity: 1; }
  .egpf__thumb.is-active::after { transform: scaleX(1); }

  /* Buy box: right third (2 photos) / floating card over the right photo (3+) */
  .egpf__buy {
    position: absolute; top: 0; right: 0; bottom: 0; width: 33.3333%; z-index: 4;
    display: flex; flex-direction: column; justify-content: center;
    padding: 2.5rem clamp(1.5rem, 3vw, 3rem);
    background: var(--egpf-bg, #F8F6F6);
    overflow-y: auto;
  }
  .egpf--many .egpf__buy {
    top: auto; bottom: 1.5rem; right: 1.5rem; width: clamp(300px, 25vw, 380px);
    max-height: calc(100% - 3rem);
    padding: 1.5rem 1.5rem 1.4rem;
    background: #FCFAF7;
  }
  .egpf__vendor { margin: 0 0 .5rem; font-size: .7rem; letter-spacing: .22em; text-transform: uppercase; opacity: .55; }
  .egpf__by { margin: -.6rem 0 1rem; font-size: .8rem; color: rgba(26,26,26,.7); }
  .egpf__by a { color: inherit; text-decoration: underline; text-underline-offset: 3px; }
  .egpf__title { margin: 0 0 1rem; font-family: var(--eg-serif, 'Cormorant Garamond', serif); font-weight: 400; font-size: clamp(1.2rem, 1.6vw, 1.7rem); line-height: 1.2; }
  .egpf__option { border: 0; padding: 0; margin: 0 0 1rem; min-width: 0; }
  .egpf__label {
    display: flex; justify-content: space-between; gap: 1rem; width: 100%; padding: 0;
    font-size: .74rem; margin-bottom: .7rem;
  }
  .egpf__label > span:first-child {
    font-family: ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace;
    font-size: .7rem; letter-spacing: .06em; text-transform: uppercase;
  }
  .egpf__chosen { text-align: right; }
  .egpf__pills { display: flex; flex-wrap: wrap; gap: .4rem; }
  .egpf__pill {
    padding: .5rem .9rem; border: 1px solid rgba(26,26,26,.3); background: transparent;
    font: inherit; font-size: .8rem; cursor: pointer; border-radius: 0;
  }
  .egpf__pill.is-active { border-color: #1a1a1a; background: #1a1a1a; color: #fff; }
  .egpf__pill--swatch { position: relative; width: 54px; height: 54px; padding: 0; border: 0; background: transparent; margin-bottom: 6px; }
  .egpf__pill--swatch img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .egpf__pill--swatch::after { content: ''; position: absolute; left: 0; right: 0; bottom: -6px; height: 2px; background: #1a1a1a; transform: scaleX(0); transition: transform .25s ease; }
  .egpf__pill--swatch.is-active { background: transparent; }
  .egpf__pill--swatch.is-active::after, .egpf__pill--swatch:hover::after { transform: scaleX(1); }
  .egpf__price { margin: .4rem 0 .8rem; text-align: right; font-size: .9rem; }
  .egpf__actions { display: grid; grid-template-columns: 1fr; gap: .5rem; }
  .egpf__actions--two { grid-template-columns: 1fr 2fr; gap: 0; }
  .egpf__actions--two .egpf__pay .shopify-payment-button__button { border: 1px solid #1a1a1a; }
  .egpf__add {
    display: inline-flex; align-items: center; justify-content: center; gap: .5rem;
    width: 100%; min-height: 44px; padding: .8rem; border: 0; background: #1a1a1a; color: #fff;
    font-family: ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace; font-size: .72rem; letter-spacing: .08em; text-transform: uppercase; cursor: pointer;
  }
  .egpf__add[disabled] { opacity: .45; cursor: not-allowed; }
  .egpf__pay { min-width: 0; }
  .egpf__pay .shopify-payment-button__button { min-height: 44px; border-radius: 0; }
  .egpf__pay .shopify-payment-button__more-options { display: none; }

  .egpf__below {
    display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: clamp(2rem, 6vw, 6rem);
    max-width: 1240px; margin: 0 auto; padding: clamp(3rem, 6vw, 5rem) var(--eg-gutter, clamp(1.25rem, 6vw, 6rem));
    font-size: .92rem; line-height: 1.65;
  }
  .egpf__desc p { margin: 0 0 .8rem; }
  .egpf__meta p { margin: 0 0 .35rem; color: rgba(26,26,26,.6); }
  .egpf__meta a { color: inherit; text-decoration: underline; text-underline-offset: 3px; }
  .egpf__story { max-width: 46rem; margin: 0 auto; padding: clamp(3rem, 6vw, 5rem) 1.5rem; text-align: center; }
  .egpf__story-title { margin: 0 0 1rem; font-family: var(--eg-serif, 'Cormorant Garamond', serif); font-style: italic; font-weight: 400; font-size: clamp(1.8rem, 2.6vw, 2.4rem); }
  .egpf__story-text, .egpf__story-quote { font-family: var(--eg-serif, 'Cormorant Garamond', serif); font-style: italic; font-size: clamp(1.1rem, 1.5vw, 1.35rem); line-height: 1.5; }
  .egpf__story-quote { margin-top: 1.25rem; opacity: .8; }
  .egpf__story-name { margin: 0 0 .75rem; font-family: ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace; font-size: .72rem; letter-spacing: .08em; text-transform: uppercase; }
  .egpf__story-link {
    display: inline-block; margin-top: 1.75rem; padding-bottom: .25rem; border-bottom: 1px solid currentColor;
    font-family: ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace; font-size: .72rem; letter-spacing: .08em; text-transform: uppercase;
    color: #1a1a1a; text-decoration: none;
  }
  .egpf__crumbs {
    display: flex; justify-content: center; gap: .6rem; padding: 2rem 1rem 3rem;
    font-family: ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace; font-size: .68rem; letter-spacing: .06em; text-transform: uppercase; color: rgba(26,26,26,.7);
  }
  .egpf__crumbs a { color: inherit; text-decoration: underline; text-underline-offset: 3px; }

  /* Sticky bar that appears once the buy box scrolls away (Hermès) */
  .egpf__sticky {
    position: fixed; left: 0; right: 0; bottom: var(--egpf-pbar, 0px); z-index: 900;
    display: flex; align-items: center; justify-content: space-between; gap: 1rem;
    padding: .7rem var(--eg-gutter, 1.5rem); background: #FCFAF7; box-shadow: 0 -1px 0 rgba(26,26,26,.08);
    transform: translateY(110%); transition: transform .35s ease;
  }
  .egpf__sticky.is-visible { transform: translateY(0); }
  .egpf__sticky-info { display: flex; align-items: center; gap: .9rem; min-width: 0; }
  .egpf__sticky-img { width: 40px; height: 52px; object-fit: cover; display: block; }
  .egpf__sticky-title { margin: 0; font-size: .85rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .egpf__sticky-price { margin: 0; font-size: .8rem; opacity: .75; }
  .egpf__sticky-form { flex: 0 0 auto; width: min(380px, 50vw); }
  .egpf__sticky-add { width: 100%; }

  /* Zoom view */
  .egpf__zoom { position: fixed; inset: 0; z-index: 1000; background: #fff; }
  .egpf__zoom[hidden] { display: none; }
  .egpf__close {
    position: fixed; top: 1.25rem; right: 1.5rem; z-index: 3;
    width: 2rem; height: 2rem; border: 0; background: transparent;
    color: #1a1a1a; font-size: 1.9rem; font-weight: 200; line-height: 1; cursor: pointer;
  }
  .egpf__zoomctl {
    position: fixed; left: 1.75rem; top: 50%; transform: translateY(-50%); z-index: 3;
    display: flex; flex-direction: column; align-items: center; gap: .6rem;
  }
  .egpf__zoombtn { width: 1.5rem; height: 1.5rem; border: 0; background: transparent; font-size: 1.35rem; font-weight: 200; line-height: 1; cursor: pointer; color: #1a1a1a; }
  .egpf__zoomrange {
    writing-mode: vertical-lr; direction: rtl; -webkit-appearance: none; appearance: none;
    width: 9px; height: 31vh; margin: 0; background: transparent; cursor: pointer;
  }
  .egpf__zoomrange::-webkit-slider-runnable-track { width: 1px; background: #1a1a1a; }
  .egpf__zoomrange::-moz-range-track { width: 1px; background: #1a1a1a; }
  .egpf__zoomrange::-webkit-slider-thumb { -webkit-appearance: none; width: 7px; height: 7px; border-radius: 50%; background: #1a1a1a; margin-left: -3px; }
  .egpf__zoomrange::-moz-range-thumb { width: 7px; height: 7px; border: 0; border-radius: 50%; background: #1a1a1a; }
  .egpf__zoom-list { height: 100%; overflow-y: auto; scroll-snap-type: y mandatory; scrollbar-width: none; }
  .egpf__zoom-list::-webkit-scrollbar { display: none; }
  .egpf__zoom-item { height: 100vh; scroll-snap-align: start; overflow: hidden; background: #fff; }
  .egpf__zoom-item img { width: 100%; height: 100%; object-fit: contain; display: block; transition: transform .2s ease; transform-origin: 50% 50%; }
  .egpf__zoom-item.is-zoomed img { cursor: grab; }
  .egpf__zoom-thumbs {
    position: fixed; left: 1.25rem; bottom: calc(1.25rem + var(--egpf-pbar, 0px)); z-index: 3;
    display: flex; gap: .35rem; padding: 0 0 7px; background: transparent;
    max-width: calc(100% - 2.5rem); overflow-x: auto;
  }
  html.egpf-zoom-open, html.egpf-zoom-open body { overflow: hidden; }

  /* Phone: one photo at a time (swipe), buy box underneath */
  @media screen and (max-width: 989px) {
    #egpf-{{ section.id }} { padding: 0 0 2rem; }
    .egpf__frame { height: auto; min-height: 0; }
    .egpf__stage, .egpf--two .egpf__stage, .egpf--one .egpf__stage {
      position: relative; inset: auto; right: auto; aspect-ratio: 4 / 5;
      overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none;
    }
    .egpf__stage::-webkit-scrollbar { display: none; }
    .egpf__track { transform: none !important; }
    .egpf__slot, .egpf--one .egpf__slot, .egpf--many .egpf__slot { flex-basis: 100%; scroll-snap-align: start; }
    .egpf__slot + .egpf__slot { border-left: 0; }
    .egpf__arrow { display: none; }
    .egpf__thumbs { position: relative; left: auto; bottom: auto; max-width: none; padding: .75rem 1rem 6px; }
    .egpf__buy, .egpf--many .egpf__buy {
      position: relative; inset: auto; width: auto; max-height: none;
      padding: 1.5rem 1rem; background: var(--egpf-bg, #F8F6F6);
    }
    .egpf__back { top: .75rem; left: .75rem; }
    .egpf__below { grid-template-columns: 1fr; gap: 1.25rem; padding: 2rem 1rem; }
    /* small windows: like Hermès, the bar is always there with Apple Pay + Add to cart */
    .egpf__sticky { padding: .6rem .75rem; }
    .egpf__sticky-info { display: none; }
    .egpf__sticky-form { width: 100%; }
    .egpf__actions--two { grid-template-columns: 1fr 1fr; }
    #egpf-{{ section.id }} { padding-bottom: 72px; }
    .egpf__zoomctl { left: .5rem; }
    .egpf__zoomrange { height: 22vh; }
  }
{%- endstyle -%}

<script>
  (function () {
    var root = document.getElementById('egpf-{{ section.id }}');
    if (!root) return;
    var variants = [];
    try { variants = JSON.parse(root.querySelector('[data-egpf-variants]').textContent); } catch (e) {}
    var count = Number(root.dataset.count) || 0;
    var many = root.classList.contains('egpf--many');
    var stage = root.querySelector('[data-egpf-stage]');
    var track = root.querySelector('[data-egpf-track]');
    var slots = root.querySelectorAll('[data-egpf-slot]');
    var thumbs = root.querySelectorAll('[data-egpf-thumb]');
    var prevBtn = root.querySelector('[data-egpf-prev]');
    var nextBtn = root.querySelector('[data-egpf-next]');
    var idInput = root.querySelector('[data-egpf-id]');
    var priceEl = root.querySelector('[data-egpf-price]');
    var addBtn = root.querySelector('[data-egpf-add]');
    var addLabel = root.querySelector('[data-egpf-add-label]');
    var moneyFormat = {{ shop.money_format | json }};
    var mq = window.matchMedia('(max-width: 989px)');
    /* let the frame fill the screen under the site header */
    function setHeader() {
      /* everything above the frame (announcement bar + header) */
      var top = Math.round(root.getBoundingClientRect().top + window.scrollY);
      if (top > 0 && top < 400) root.style.setProperty('--egpf-header', top + 'px');
    }
    setHeader(); window.addEventListener('resize', setHeader);
    /* Shopify's black preview bar (only shown in previews) covers the bottom of the
       screen; measure it so the small photos and buttons stay visible above it */
    function setPreviewBar() {
      var bar = document.querySelector('#PBarNextFrameWrapper, #preview-bar-iframe, [id^="PBar"]');
      var h = 0;
      if (bar) {
        var r = bar.getBoundingClientRect();
        if (getComputedStyle(bar).display !== 'none' && r.height > 0 && r.top < window.innerHeight) h = Math.round(window.innerHeight - r.top);
      }
      document.documentElement.style.setProperty('--egpf-pbar', Math.max(0, Math.min(h, 120)) + 'px');
    }
    setPreviewBar(); setInterval(setPreviewBar, 1000); window.addEventListener('resize', setPreviewBar);
    var pos = 0;      /* index of the photo in the left frame */
    var current = 0;  /* index of the photo the shopper picked */

    function money(cents) { return moneyFormat.replace(/\{\{\s*\w+\s*\}\}/, (cents / 100).toFixed(2)); }
    /* 3+ photos: the strip never moves past the last 3, so 3 whole photos always show */
    function maxPos() { return mq.matches ? Math.max(0, count - 1) : (many ? Math.max(0, count - 3) : 0); }
    function markThumb(i) {
      thumbs.forEach(function (t) { t.classList.toggle('is-active', Number(t.dataset.egpfThumb) === i); });
      var a = thumbs[i];
      if (a && a.parentNode) a.parentNode.scrollTo({ left: a.offsetLeft - a.parentNode.clientWidth / 2, behavior: 'smooth' });
    }
    /* Load the photos in view plus the next few now, so a shifted frame is never blank */
    function warm() {
      for (var k = Math.max(0, pos - 1); k <= Math.min(count - 1, pos + 4); k++) {
        var im = slots[k] && slots[k].querySelector('img');
        if (im && im.loading === 'lazy') im.loading = 'eager';
      }
    }
    function applyPos() {
      if (mq.matches) {
        track.style.transform = '';
        stage.scrollTo({ left: pos * stage.clientWidth, behavior: 'smooth' });
      } else {
        /* desktop: no leftover sideways scroll from the phone layout, and move by exact thirds */
        if (stage.scrollLeft) stage.scrollLeft = 0;
        track.style.transform = many ? 'translateX(' + (-pos * 100 / 3) + '%)' : '';
      }
      if (prevBtn) prevBtn.disabled = pos <= 0;
      if (nextBtn) nextBtn.disabled = pos >= maxPos();
      warm();
    }
    /* Show photo i: on desktop the strip shifts so photo i comes into the open frames with the
       one before it on its left (click the 3rd -> 2nd and 3rd, the 1st slides out). */
    function show(i) {
      if (!count) return;
      i = Math.max(0, Math.min(i, count - 1));
      current = i;
      pos = mq.matches ? i : Math.max(0, Math.min(i - 1, maxPos()));
      applyPos();
      markThumb(i);
    }
    /* Arrows move the pair one photo at a time */
    function step(d) {
      pos = Math.max(0, Math.min(pos + d, maxPos()));
      current = mq.matches ? pos : Math.min(count - 1, pos + 1);
      applyPos();
      markThumb(current);
    }
    thumbs.forEach(function (t) { t.addEventListener('click', function () { show(Number(t.dataset.egpfThumb)); }); });
    if (prevBtn) prevBtn.addEventListener('click', function () { step(-1); });
    if (nextBtn) nextBtn.addEventListener('click', function () { step(1); });
    window.addEventListener('resize', function () { show(current); });
    stage.addEventListener('scroll', function () {
      if (!mq.matches) return;
      var i = Math.round(stage.scrollLeft / stage.clientWidth);
      if (i !== current) { current = i; pos = i; markThumb(i); }
    }, { passive: true });

    function indexOfMedia(id) {
      for (var k = 0; k < slots.length; k++) { if (String(slots[k].dataset.mediaId) === String(id)) return k; }
      return -1;
    }

    /* Colour boxes */
    var chosen = [];
    root.querySelectorAll('.egpf__option').forEach(function (fs, i) {
      var a = fs.querySelector('.egpf__pill.is-active');
      chosen[i] = a ? a.dataset.value : null;
    });
    root.querySelectorAll('[data-egpf-opt]').forEach(function (pill) {
      pill.addEventListener('click', function () {
        var i = Number(pill.dataset.egpfOpt);
        chosen[i] = pill.dataset.value;
        pill.parentNode.querySelectorAll('.egpf__pill').forEach(function (p) { p.classList.toggle('is-active', p === pill); });
        var label = root.querySelector('[data-egpf-chosen="' + i + '"]');
        if (label) label.textContent = pill.dataset.value;
        var v = variants.find(function (x) { return x.options.every(function (o, k) { return chosen[k] == null || o === chosen[k]; }); });
        if (!v) return;
        idInput.value = v.id;
        if (priceEl) priceEl.textContent = money(v.price);
        var sp = document.querySelector('[data-egpf-sticky-price]'); if (sp) sp.textContent = money(v.price);
        var sid = document.querySelector('[data-egpf-sticky-id]'); if (sid) sid.value = v.id;
        var sb = document.querySelector('[data-egpf-sticky-add]'); if (sb) sb.disabled = !v.available;
        var sl = document.querySelector('[data-egpf-sticky-label]'); if (sl) sl.textContent = v.available ? 'Add to cart' : 'Sold out';
        var sk = root.querySelector('[data-egpf-sku]'); if (sk) sk.textContent = v.sku || '';
        if (addBtn) { addBtn.disabled = !v.available; }
        if (addLabel) { addLabel.textContent = v.available ? 'Add to cart' : 'Sold out'; }
        if (v.featured_media) { var idx = indexOfMedia(v.featured_media.id); if (idx > -1) show(idx); }
        var url = new URL(window.location.href);
        url.searchParams.set('variant', v.id);
        window.history.replaceState({}, '', url.toString());
      });
    });

    /* Zoom view: scroll down through the photos, + / − slider on the left */
    var zoom = root.querySelector('[data-egpf-zoom]');
    if (zoom) {
      document.body.appendChild(zoom);
      var zoomList = zoom.querySelector('[data-egpf-zoom-list]');
      var zoomItems = zoom.querySelectorAll('[data-egpf-zoom-item]');
      var zoomThumbs = zoom.querySelectorAll('[data-egpf-zoom-thumb]');
      var range = zoom.querySelector('[data-egpf-zoom-range]');
      var zIn = zoom.querySelector('[data-egpf-zoom-in]');
      var zOut = zoom.querySelector('[data-egpf-zoom-out]');
      var zIndex = 0;
      var origin = '50% 50%';

      function zoomImg() { var it = zoomItems[zIndex]; return it ? it.querySelector('img') : null; }
      function setScale(s) {
        s = Math.max(1, Math.min(3, Number(s) || 1));
        range.value = s;
        zoomItems.forEach(function (it, k) {
          var img = it.querySelector('img');
          if (!img) return;
          if (k === zIndex) { img.style.transformOrigin = origin; img.style.transform = 'scale(' + s + ')'; it.classList.toggle('is-zoomed', s > 1); }
          else { img.style.transform = ''; it.classList.remove('is-zoomed'); }
        });
      }
      function markZoomThumb(i) {
        zoomThumbs.forEach(function (t) { t.classList.toggle('is-active', Number(t.dataset.egpfZoomThumb) === i); });
      }
      function openZoom(i) {
        zoom.hidden = false;
        document.documentElement.classList.add('egpf-zoom-open');
        zIndex = i; origin = '50% 50%';
        var it = zoomItems[i];
        if (it) zoomList.scrollTo({ top: it.offsetTop, behavior: 'instant' });
        setScale(1);
        markZoomThumb(i);
      }
      function closeZoom() {
        zoom.hidden = true;
        document.documentElement.classList.remove('egpf-zoom-open');
        setScale(1);
      }
      slots.forEach(function (s) { s.addEventListener('click', function () { openZoom(Number(s.dataset.egpfSlot)); }); });
      zoomThumbs.forEach(function (t) {
        t.addEventListener('click', function () {
          var it = zoomItems[Number(t.dataset.egpfZoomThumb)];
          if (it) zoomList.scrollTo({ top: it.offsetTop, behavior: 'smooth' });
        });
      });
      zoomList.addEventListener('scroll', function () {
        var i = Math.round(zoomList.scrollTop / zoomList.clientHeight);
        if (i !== zIndex) { zIndex = i; origin = '50% 50%'; setScale(1); markZoomThumb(i); }
      }, { passive: true });
      range.addEventListener('input', function () { setScale(range.value); });
      zIn.addEventListener('click', function () { setScale(Number(range.value) + 0.5); });
      zOut.addEventListener('click', function () { setScale(Number(range.value) - 0.5); });
      /* when zoomed in, move the mouse to look around the photo */
      zoomItems.forEach(function (it) {
        it.addEventListener('mousemove', function (e) {
          if (!it.classList.contains('is-zoomed')) return;
          var r = it.getBoundingClientRect();
          origin = ((e.clientX - r.left) / r.width * 100) + '% ' + ((e.clientY - r.top) / r.height * 100) + '%';
          var img = it.querySelector('img'); if (img) img.style.transformOrigin = origin;
        });
        var img = it.querySelector('img');
        if (img) img.addEventListener('click', function (e) {
          var r = it.getBoundingClientRect();
          origin = ((e.clientX - r.left) / r.width * 100) + '% ' + ((e.clientY - r.top) / r.height * 100) + '%';
          setScale(Number(range.value) > 1 ? 1 : 2);
        });
      });
      zoom.querySelector('[data-egpf-zoom-close]').addEventListener('click', closeZoom);
      document.addEventListener('keydown', function (e) { if (!zoom.hidden && e.key === 'Escape') closeZoom(); });
    }

    /* Sticky add-to-cart bar once the buy box is off screen */
    var sticky = root.querySelector('[data-egpf-sticky]');
    var buy = root.querySelector('.egpf__buy');
    if (sticky && buy && 'IntersectionObserver' in window) {
      document.body.appendChild(sticky);
      /* Show the bar whenever the card's own Add to cart button is not fully on screen:
         small or short windows, scrolled past, or hidden under Shopify's preview strip */
      var buyBtn = buy.querySelector('[name="add"], button[type="submit"]') || buy;
      function updateSticky() {
        var r = buyBtn.getBoundingClientRect();
        var pb = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--egpf-pbar')) || 0;
        var seen = r.height > 0 && r.top >= 0 && r.bottom <= window.innerHeight - pb;
        var on = mq.matches || !seen;
        sticky.classList.toggle('is-visible', on);
        sticky.setAttribute('aria-hidden', on ? 'false' : 'true');
        var b = sticky.querySelector('[data-egpf-sticky-add]'); if (b) b.tabIndex = on ? 0 : -1;
      }
      window.addEventListener('scroll', updateSticky, { passive: true });
      window.addEventListener('resize', updateSticky);
      setInterval(updateSticky, 1000);
      if (mq.addEventListener) mq.addEventListener('change', updateSticky);
      updateSticky();
    }

    /* Back: return to the previous page if it was on this store, otherwise the collection */
    var back = root.querySelector('[data-egpf-back]');
    if (back && document.referrer && document.referrer.indexOf(window.location.host) > -1) {
      back.addEventListener('click', function (e) { e.preventDefault(); history.back(); });
    }

    /* Start on the selected colour's photo */
    var start = 0;
    var sel = variants.find(function (x) { return String(x.id) === String(idInput && idInput.value); });
    if (sel && sel.featured_media) { var si = indexOfMedia(sel.featured_media.id); if (si > -1) start = si; }
    show(start);
  })();
</script>

{% schema %}
{
  "name": "EG Product Frame",
  "settings": [
    { "type": "paragraph", "content": "Hermès-style frame. 3+ photos: two photos side by side, buy box floats over the right photo, clicking a later photo shifts the pair. 2 photos: buy box takes the right third. Click a photo to zoom." },
    { "type": "range", "id": "frame_height", "label": "Frame height (% of screen)", "min": 60, "max": 100, "step": 2, "unit": "%", "default": 100 },
    { "type": "color", "id": "frame_bg", "label": "Background", "default": "#F8F5F0" },
    { "type": "checkbox", "id": "show_vendor", "label": "Show vendor", "default": false },
    { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Show Apple Pay / Buy now button next to Add to cart", "default": true },
    { "type": "checkbox", "id": "show_description", "label": "Show description under the frame", "default": true },
    { "type": "url", "id": "contact_url", "label": "Contact Customer Service link" },
    { "type": "checkbox", "id": "show_story", "label": "Show the artisan's story below (from the product's Artisan)", "default": true },
    { "type": "text", "id": "story_heading", "label": "Story heading", "default": "The story behind" },
    { "type": "checkbox", "id": "story_first_paragraph", "label": "Show only the first paragraph of the story", "default": true }
  ]
}
{% endschema %}
