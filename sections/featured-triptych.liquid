{%- liquid
  assign headline = section.settings.headline
-%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="eg-triptych section-{{ section.id }}-padding">
    <div class="eg-triptych__inner page-width">
      {%- if headline != blank -%}
        <h2 class="eg-triptych__headline">{{ headline | newline_to_br }}</h2>
      {%- endif -%}

      <div class="eg-triptych__grid">
        {%- for block in section.blocks -%}
          <a href="{{ block.settings.link | default: '#' }}" class="eg-triptych__card eg-triptych__card--{{ forloop.index }}" {{ block.shopify_attributes }}>
            <div class="eg-triptych__media">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400, 600, 800, 900', sizes: '(min-width: 990px) 30vw, 90vw', alt: block.settings.artisan }}
              {%- else -%}
                {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>
            <div class="eg-triptych__meta">
              {%- if block.settings.artisan != blank -%}
                <span class="eg-triptych__artisan">{{ block.settings.artisan }}</span>
              {%- endif -%}
              {%- if block.settings.piece != blank -%}
                <span class="eg-triptych__piece">{{ block.settings.piece }}</span>
              {%- endif -%}
            </div>
          </a>
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

{%- style -%}
  .section-{{ section.id }}-padding { padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px; padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px; }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding { padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; }
  }
  .eg-triptych__headline { font-family: var(--font-heading-family); font-weight: 300; font-size: clamp(1.75rem, 3.2vw, 2.75rem); letter-spacing: 0.04em; text-transform: uppercase; text-align: center; line-height: 1.15; margin: 0 0 clamp(2.5rem, 5vw, 4.5rem); color: rgb(var(--color-foreground)); }
  .eg-triptych__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(1.5rem, 3vw, 3rem); align-items: start; }
  .eg-triptych__card { display: flex; flex-direction: column; text-decoration: none; color: rgb(var(--color-foreground)); transition: opacity 0.3s ease; }
  .eg-triptych__card:hover { opacity: 0.85; }
  .eg-triptych__card--1 { margin-top: 6rem; }
  .eg-triptych__card--2 { margin-top: 0; }
  .eg-triptych__card--3 { margin-top: 3rem; }
  .eg-triptych__media { width: 100%; overflow: hidden; margin-bottom: 1rem; }
  .eg-triptych__media img, .eg-triptych__media svg { width: 100%; height: auto; aspect-ratio: 3 / 4; object-fit: cover; display: block; transition: transform 1s cubic-bezier(.2,.7,.2,1); }
  .eg-triptych__card:hover .eg-triptych__media img { transform: scale(1.03); }
  .eg-triptych__meta { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; }
  .eg-triptych__artisan { font-family: var(--font-body-family); font-size: 0.72rem; letter-spacing: 0.22em; text-transform: uppercase; }
  .eg-triptych__piece { font-family: var(--font-heading-family); font-style: italic; font-size: 0.85rem; opacity: 0.75; }
  @media screen and (max-width: 749px) {
    .eg-triptych__grid { grid-template-columns: 1fr; gap: 2rem; }
    .eg-triptych__card--1, .eg-triptych__card--2, .eg-triptych__card--3 { margin-top: 0; }
  }
{%- endstyle -%}

{% schema %}
{
  "name": "Featured Triptych",
  "tag": "section",
  "class": "section",
  "max_blocks": 3,
  "settings": [
    { "type": "text", "id": "headline", "label": "Headline", "default": "Pieces that move with you" },
    { "type": "header", "content": "Appearance" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 96 }
  ],
  "blocks": [
    {
      "type": "piece",
      "name": "Piece",
      "limit": 3,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Portrait image (3:4)" },
        { "type": "text", "id": "artisan", "label": "Artisan name", "default": "Artisan Name" },
        { "type": "text", "id": "piece", "label": "Piece name", "default": "Piece description" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    { "name": "Featured Triptych", "blocks": [ { "type": "piece" }, { "type": "piece" }, { "type": "piece" } ] }
  ]
}
{% endschema %}