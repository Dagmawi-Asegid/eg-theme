{%- liquid
  assign hero_image = section.settings.hero_image
  assign headline = section.settings.headline
  assign quote = section.settings.quote
  assign attribution = section.settings.attribution
  assign collection_image = section.settings.collection_image
  assign collection_eyebrow = section.settings.collection_eyebrow
  assign collection_title = section.settings.collection_title
  assign collection_url = section.settings.collection_url
  assign image_position = section.settings.image_position
-%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="eg-hero section-{{ section.id }}-padding eg-hero--image-{{ image_position }}">
    <div class="eg-hero__inner page-width">
      {%- if hero_image != blank -%}
        <div class="eg-hero__media">
          {{ hero_image | image_url: width: 1600 | image_tag:
            loading: 'eager',
            fetchpriority: 'high',
            widths: '600, 800, 1000, 1200, 1400, 1600',
            sizes: '(min-width: 990px) 58vw, 100vw',
            alt: hero_image.alt | default: 'Hero'
          }}
        </div>
      {%- else -%}
        <div class="eg-hero__media eg-hero__media--placeholder">
          {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
        </div>
      {%- endif -%}

      <div class="eg-hero__content">
        {%- if headline != blank -%}
          <h1 class="eg-hero__headline">{{ headline | newline_to_br }}</h1>
        {%- endif -%}

        {%- if quote != blank -%}
          <p class="eg-hero__quote">
            <span class="eg-hero__quote-text">{{ quote }}</span>
            {%- if attribution != blank -%}
              <span class="eg-hero__attribution">— {{ attribution }}</span>
            {%- endif -%}
          </p>
        {%- endif -%}

        {%- if collection_image != blank or collection_title != blank -%}
          <a href="{{ collection_url | default: '#' }}" class="eg-hero__feature">
            {%- if collection_image != blank -%}
              <div class="eg-hero__feature-media">
                {{ collection_image | image_url: width: 480 | image_tag:
                  loading: 'lazy',
                  widths: '240, 360, 480',
                  sizes: '140px',
                  alt: collection_title | default: '' | escape
                }}
              </div>
            {%- endif -%}
            <div class="eg-hero__feature-text">
              {%- if collection_eyebrow != blank -%}
                <span class="eg-hero__feature-eyebrow">{{ collection_eyebrow }}</span>
              {%- endif -%}
              {%- if collection_title != blank -%}
                <span class="eg-hero__feature-title">{{ collection_title }}</span>
              {%- endif -%}
              <span class="eg-hero__feature-arrow" aria-hidden="true">
                <svg width="36" height="36" viewBox="0 0 36 36" fill="none" stroke="currentColor" stroke-width="0.75">
                  <circle cx="18" cy="18" r="17.5"/>
                  <path d="M15 12l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </div>
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .eg-hero { overflow: hidden; }

  .eg-hero__inner {
    display: grid;
    grid-template-columns: 1.45fr 1fr;
    gap: clamp(2rem, 4vw, 5rem);
    align-items: center;
  }

  .eg-hero--image-right .eg-hero__media { order: 2; }
  .eg-hero--image-right .eg-hero__content { order: 1; padding: 0 2rem 0 5rem; }

  .eg-hero__media { width: 100%; }
  .eg-hero__media img {
    width: 100%;
    height: auto;
    display: block;
    aspect-ratio: 5 / 6;
    object-fit: cover;
  }

  .eg-hero__content {
    padding: 0 5rem 0 2rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.75rem;
  }

  .eg-hero__headline {
    font-family: var(--font-heading-family);
    font-weight: 300;
    font-size: clamp(2.5rem, 5vw, 4.25rem);
    line-height: 1.02;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin: 0;
    color: rgb(var(--color-foreground));
  }

  .eg-hero__quote {
    font-family: var(--font-heading-family);
    font-style: italic;
    font-size: clamp(0.875rem, 1vw, 1rem);
    line-height: 1.6;
    max-width: 38ch;
    margin: 0;
    opacity: 0.85;
    color: rgb(var(--color-foreground));
  }
  .eg-hero__attribution { font-style: normal; margin-left: 0.25rem; opacity: 0.75; }

  .eg-hero__feature {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    text-decoration: none;
    color: rgb(var(--color-foreground));
    margin-top: 1rem;
    padding: 0.5rem;
    transition: opacity 0.3s ease;
  }
  .eg-hero__feature:hover { opacity: 0.78; }

  .eg-hero__feature-media { width: 140px; flex-shrink: 0; }
  .eg-hero__feature-media img {
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    display: block;
  }

  .eg-hero__feature-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.35rem;
    text-align: left;
  }

  .eg-hero__feature-eyebrow {
    font-family: var(--font-body-family);
    font-size: 0.65rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    opacity: 0.55;
  }

  .eg-hero__feature-title {
    font-family: var(--font-heading-family);
    font-weight: 400;
    font-size: 1.05rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    line-height: 1.25;
    border-bottom: 1px solid #5B2545;
    padding-bottom: 0.4rem;
    margin-bottom: 0.25rem;
  }

  .eg-hero__feature-arrow {
    margin-top: 0.6rem;
    display: inline-flex;
    transition: transform 0.3s cubic-bezier(.2,.7,.2,1);
  }
  .eg-hero__feature:hover .eg-hero__feature-arrow { transform: translateX(6px); }

  @media screen and (max-width: 749px) {
    .eg-hero__inner { grid-template-columns: 1fr; gap: 2.5rem; }
    .eg-hero--image-right .eg-hero__media,
    .eg-hero--image-right .eg-hero__content { order: initial; padding: 0 1.25rem; }
    .eg-hero__content { padding: 0 1.25rem; }
    .eg-hero__media img { aspect-ratio: 4 / 5; }
    .eg-hero__feature-media { width: 110px; }
  }
{%- endstyle -%}

{% schema %}
{
  "name": "Hero Editorial",
  "tag": "section",
  "class": "section section-eg-hero",
  "settings": [
    { "type": "header", "content": "Hero image" },
    { "type": "image_picker", "id": "hero_image", "label": "Hero image" },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    { "type": "header", "content": "Headline & quote" },
    {
      "type": "textarea",
      "id": "headline",
      "label": "Headline",
      "default": "Stunning\nStarts",
      "info": "Use line breaks to split across multiple lines."
    },
    {
      "type": "text",
      "id": "quote",
      "label": "Quote",
      "default": "She walks in beauty like the night of cloudless climes and starry skies."
    },
    { "type": "text", "id": "attribution", "label": "Quote attribution", "default": "Lord Byron" },
    { "type": "header", "content": "Featured collection card" },
    { "type": "image_picker", "id": "collection_image", "label": "Collection image (square crop recommended)" },
    { "type": "text", "id": "collection_eyebrow", "label": "Eyebrow text", "default": "Explore" },
    { "type": "text", "id": "collection_title", "label": "Collection title", "default": "The Natural Collection" },
    { "type": "url", "id": "collection_url", "label": "Collection link" },
    { "type": "header", "content": "Appearance" },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 96 }
  ],
  "presets": [
    { "name": "Hero Editorial" }
  ]
}
{% endschema %}