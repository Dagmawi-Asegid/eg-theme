{%- comment -%}
  EG Journal — sections/eg-journal.liquid
  Simon layout 09. A quote, then a single-line email signup.
  Signups are saved as customers tagged "newsletter".
{%- endcomment -%}

{%- assign form_id = 'egnl-' | append: section.id -%}

<div class="egnl" style="padding-top: {{ section.settings.pad_top }}rem; padding-bottom: {{ section.settings.pad_bottom }}rem;">
  {%- if section.settings.quote != blank -%}
    <blockquote class="egnl__quote">{{ section.settings.quote | newline_to_br }}</blockquote>
  {%- endif -%}

  {%- form 'customer', id: form_id, class: 'egnl__form' -%}
    <input type="hidden" name="contact[tags]" value="newsletter">
    {%- if form.posted_successfully? -%}
      <p class="egnl__msg" role="status">{{ section.settings.success }}</p>
    {%- else -%}
      <div class="egnl__field">
        <label class="visually-hidden" for="{{ form_id }}-email">{{ section.settings.placeholder }}</label>
        <input
          id="{{ form_id }}-email"
          class="egnl__input"
          type="email"
          name="contact[email]"
          placeholder="{{ section.settings.placeholder }}"
          autocomplete="email"
          autocorrect="off"
          autocapitalize="off"
          required
        >
        <button type="submit" class="egnl__btn">{{ section.settings.button }}</button>
      </div>
      {%- if form.errors -%}
        <p class="egnl__msg egnl__msg--error" role="alert">{{ form.errors.translated_fields['email'] | capitalize }} {{ form.errors.messages['email'] }}</p>
      {%- endif -%}
    {%- endif -%}
  {%- endform -%}
</div>

{%- style -%}
  .egnl {
    padding-left: 1.5rem;
    padding-right: 1.5rem;
    text-align: center;
    color: var(--eg-ink, #1a1a1a);
  }
  .egnl__quote {
    max-width: 40rem;
    margin: 0 auto clamp(2.25rem, 4vw, 3.25rem);
    padding: 0;
    border: 0;
    font-family: var(--eg-serif, 'Cormorant Garamond', serif);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(1.45rem, 2.2vw, 2.25rem);
    line-height: 1.3;
  }
  .egnl__field {
    display: flex;
    align-items: center;
    gap: 1rem;
    max-width: 38rem;
    margin: 0 auto;
    border-bottom: 1px solid currentColor;
  }
  .egnl__input {
    flex: 1 1 auto;
    min-width: 0;
    padding: 0.6rem 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: inherit;
    font-family: var(--eg-sans, Inter, sans-serif);
    font-size: 0.8rem;
    letter-spacing: 0.04em;
    box-shadow: none;
  }
  .egnl__input::placeholder {
    color: inherit;
    opacity: 0.7;
    font-size: 0.66rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .egnl__input:focus { outline: none; }
  .egnl__field:focus-within { border-bottom-width: 2px; }
  .egnl__btn {
    flex: 0 0 auto;
    padding: 0.6rem 0;
    border: 0;
    background: none;
    color: inherit;
    font-family: var(--eg-sans, Inter, sans-serif);
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    cursor: pointer;
    transition: opacity 0.3s ease;
  }
  .egnl__btn:hover { opacity: 0.55; }
  .egnl__btn:focus-visible { outline: 1px solid currentColor; outline-offset: 4px; }
  .egnl__msg {
    margin: 1rem auto 0;
    font-family: var(--eg-serif, 'Cormorant Garamond', serif);
    font-size: 1.1rem;
  }
  .egnl__msg--error { color: #8a1c1c; font-size: 0.95rem; }
{%- endstyle -%}

{% schema %}
{
  "name": "EG Journal",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "paragraph", "content": "Simon's section 09. Signups are saved as customers tagged newsletter." },
    { "type": "textarea", "id": "quote", "label": "Quote", "default": "“True luxury is discovering something extraordinary —\nand knowing there will never be another quite like it.”" },
    { "type": "text", "id": "placeholder", "label": "Field text", "default": "E-mail address" },
    { "type": "text", "id": "button", "label": "Button text", "default": "Newsletter Sign Up" },
    { "type": "text", "id": "success", "label": "Thank-you message", "default": "Thank you. You'll hear from us soon." },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "pad_top", "min": 0, "max": 16, "step": 1, "unit": "rem", "label": "Space above", "default": 7 },
    { "type": "range", "id": "pad_bottom", "min": 0, "max": 16, "step": 1, "unit": "rem", "label": "Space below", "default": 7 }
  ],
  "presets": [ { "name": "EG Journal" } ]
}
{% endschema %}