<section class="egband" style="--egband-h: {{ section.settings.height }}vh; --egband-frame: {{ section.settings.frame }}px;">
  <div class="egband__frame">
    <div class="egband__media eg-parallax">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 2600 | image_tag: loading: 'lazy', sizes: '100vw', widths: '800,1200,1600,2000,2600', alt: section.settings.heading }}
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </div>
    <div class="egband__content egband__content--{{ section.settings.align }} egband__content--{{ section.settings.tone }} eg-reveal">
      {%- if section.settings.eyebrow != blank -%}<p class="eg-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="eg-h2">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.body != blank -%}<p class="eg-body">{{ section.settings.body }}</p>{%- endif -%}
      {%- if section.settings.cta_label != blank -%}
        <a class="eg-link" href="{{ section.settings.cta_url | default: '#' }}">{{ section.settings.cta_label }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{%- style -%}
 .egband { background: #FFFFFF; padding: var(--egband-frame) var(--egband-frame) var(--egband-frame); }
  .egband__frame { position: relative; height: var(--egband-h); overflow: hidden; }
  .egband__media { position: absolute; inset: 0; }
  .egband__media img, .egband__media svg {
    width: 100%; height: 116%; object-fit: cover; position: absolute; top: -8%; left: 0;
  }
  .egband__content {
    position: absolute; z-index: 2;
    display: flex; flex-direction: column; gap: 1.1rem;
    max-width: 48ch;
  }
  .egband__content--left { left: clamp(1.5rem, 4vw, 4.5rem); bottom: clamp(2rem, 5vw, 4rem); align-items: flex-start; text-align: left; }
  .egband__content--center { left: 50%; top: 50%; transform: translate(-50%, -50%); align-items: center; text-align: center; }
  .egband__content--light { color: #FFF; text-shadow: 0 1px 18px rgba(0,0,0,0.3); }
  .egband__content--dark { color: #111; }
  @media screen and (max-width: 749px) {
    .egband { padding: 0; }
    .egband__frame { min-height: 64vh; }
  }
{%- endstyle -%}

{% schema %}
{
  "name": "EG Editorial Band",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "body", "label": "Body text" },
    { "type": "text", "id": "cta_label", "label": "Link label" },
    { "type": "url", "id": "cta_url", "label": "Link" },
    { "type": "select", "id": "align", "label": "Content position", "options": [
      { "value": "left", "label": "Bottom left" }, { "value": "center", "label": "Center" }
    ], "default": "left" },
    { "type": "select", "id": "tone", "label": "Text color", "options": [
      { "value": "light", "label": "Light" }, { "value": "dark", "label": "Dark" }
    ], "default": "light" },
    { "type": "range", "id": "height", "label": "Height", "min": 50, "max": 100, "step": 5, "unit": "vh", "default": 80 },
    { "type": "range", "id": "frame", "label": "White frame thickness", "min": 0, "max": 24, "step": 2, "unit": "px", "default": 6 }
  ],
  "presets": [ { "name": "EG Editorial Band" } ]
}
{% endschema %}