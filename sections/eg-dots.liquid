{%- comment -%}
  EG Dots — snippets/eg-dots.liquid
  Shared image-switching dots for Simon's homepage sections
  (reused later on the product page). Sections call: {% render 'eg-dots' %}
  Markup it looks for:
    wrapper  [data-eg-slides]
    images   .eg-slide  data-eg-slide="0", "1", ...
    buttons  .eg-dot    data-eg-dot="0", "1", ...
    optional [data-eg-swipe] = the area that responds to swipes on phones
{%- endcomment -%}
<style>
  .eg-slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.6s var(--eg-ease, cubic-bezier(0.22, 1, 0.36, 1)), visibility 0s linear 0.6s;
  }
  .eg-slide.is-active {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.6s var(--eg-ease, cubic-bezier(0.22, 1, 0.36, 1)), visibility 0s;
  }
  .eg-dots { display: flex; justify-content: center; }
  .eg-dot {
    position: relative;
    width: 14px;
    height: 18px;
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
  }
  .eg-dot::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: currentColor;
    opacity: 0.25;
    transform: translate(-50%, -50%);
    transition: opacity 0.3s ease;
  }
  .eg-dot:hover::before { opacity: 0.6; }
  .eg-dot.is-active::before { opacity: 1; }
  .eg-dot:focus-visible { outline: 1px solid currentColor; outline-offset: -3px; }
  @media (prefers-reduced-motion: reduce) {
    .eg-slide, .eg-slide.is-active { transition: none; }
  }
</style>
<script>
  (function () {
    if (window.EGDots) return;

    function setup(root) {
      if (root.dataset.egReady) return;
      root.dataset.egReady = 'true';

      var slides = root.querySelectorAll('[data-eg-slide]');
      var dots = root.querySelectorAll('[data-eg-dot]');
      var total = dots.length;
      if (total < 2) return;

      var current = 0;
      var swiped = false;

      function go(index) {
        current = (index + total) % total;
        slides.forEach(function (s) {
          s.classList.toggle('is-active', parseInt(s.dataset.egSlide, 10) === current);
        });
        dots.forEach(function (d, i) {
          var on = i === current;
          d.classList.toggle('is-active', on);
          if (on) { d.setAttribute('aria-current', 'true'); } else { d.removeAttribute('aria-current'); }
        });
      }

      dots.forEach(function (dot) {
        dot.addEventListener('click', function (e) {
          e.preventDefault();
          e.stopPropagation();
          go(parseInt(dot.dataset.egDot, 10));
        });
      });

      var area = root.querySelector('[data-eg-swipe]') || root;
      var startX = 0;
      var startY = 0;
      area.addEventListener('touchstart', function (e) {
        startX = e.touches[0].clientX;
        startY = e.touches[0].clientY;
      }, { passive: true });
      area.addEventListener('touchend', function (e) {
        var dx = e.changedTouches[0].clientX - startX;
        var dy = e.changedTouches[0].clientY - startY;
        if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy)) {
          swiped = true;
          go(dx < 0 ? current + 1 : current - 1);
          setTimeout(function () { swiped = false; }, 400);
        }
      }, { passive: true });
      area.addEventListener('click', function (e) {
        if (swiped) { e.preventDefault(); e.stopPropagation(); }
      }, true);
    }

    function init(scope) {
      (scope || document).querySelectorAll('[data-eg-slides]').forEach(setup);
    }

    window.EGDots = { init: init };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function () { init(); });
    } else {
      init();
    }
    document.addEventListener('shopify:section:load', function (e) { init(e.target); });
  })();
</script>